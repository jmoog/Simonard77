---
import Layout from '../layouts/Layout.astro';
import Icone from '../components/Icones.astro';
import Fleche from '../components/Fleche.astro';
import Ariane from '../components/Ariane.astro';
import Faq from '../components/Faq.astro';
import AppelMascotte from '../components/AppelMascotte.astro';
import AppelBandeau from '../components/AppelBandeau.astro';
import { site, reassurance } from '../data/site.js';
import { estPubliee } from '../data/urls.js';
import { pageSchema } from '../data/schema.js';

/**
 * Page « Nettoyage & démoussage de toiture » — gabarit dupliqué depuis
 * renovation-refection-de-toiture.astro.
 *
 * C'est cette prestation, et non « Entretien de toiture », que les cartes
 * des pages ville mettent en avant (démoussage, anti-mousse, hydrofuge) :
 * c'est ce que les gens recherchent, pas le mot « entretien ».
 *
 * Faits utilisés, tous documentés sur l'accueil : nettoyage manuel ou basse
 * pression selon l'état des tuiles, traitement anti-mousse, hydrofuge
 * incolore ou coloré qui retarde la repousse, contrôle des points sensibles
 * (faîtage, solins, pieds de cheminée) pendant le nettoyage.
 */
const path = '/nettoyage-demoussage-de-toiture/';
const brouillon = !estPubliee(path);

const filAriane = 'Nettoyage & démoussage de toiture';

const h1 = 'Nettoyage et démoussage de toiture en Seine-et-Marne';
const title = `Nettoyage et démoussage de toiture en ${site.address.region} (77)`;
const description = `Mousse et lichens sur le toit ? Démoussage manuel ou basse pression, anti-mousse et hydrofuge pour votre toiture en ${site.address.region}. Devis gratuit ✓ ${site.phone}.`;

const heroPhoto = '/photos/artisan-simonard-sur-echelle-pour-le-nettoyage-dune-toiture-77.webp';

const etapes = [
  { t: 'Inspection de la toiture', d: "Avant de commencer, je regarde l'état des tuiles, du faîtage et des solins. Une tuile cassée est signalée avant le nettoyage, pas découverte après." },
  { t: 'Démoussage', d: 'Je retire mousses, lichens et salissures à la brosse et au grattoir, ou à basse pression si la tuile le supporte.' },
  { t: 'Traitement anti-mousse', d: "Un produit fongicide élimine les spores qui restent après le brossage. Sans lui, la mousse repousse dès l'hiver suivant." },
  { t: 'Rinçage', d: 'Je rince la toiture sans forcer, pour ne pas décaper le grain de la tuile.' },
  { t: 'Hydrofuge', d: "Incolore ou coloré, il fait ruisseler l'eau et retarde la repousse de la mousse." },
  { t: 'Points sensibles et gouttières', d: "J'en profite pour contrôler faîtage, solins et pieds de cheminée, et je vide les gouttières des débris tombés pendant le nettoyage." },
];

const faq = [
  { q: 'Le démoussage abîme-t-il les tuiles ?', a: "Pas quand il est fait à la brosse ou à basse pression. C'est le nettoyeur haute pression qui décape la surface de la tuile et l'use avant l'heure." },
  { q: 'Peut-on appliquer un hydrofuge sans démousser avant ?', a: "Non. Sur une toiture encore couverte de mousse, l'hydrofuge l'emprisonne au lieu de l'empêcher de revenir. Le nettoyage vient toujours avant le traitement." },
  { q: 'À quelle fréquence faut-il démousser une toiture ?', a: "Cela dépend de son exposition : orientation, arbres à proximité, humidité. Je vous indique un rythme après avoir vu la toiture." },
  { q: 'Pourquoi mon toit a-t-il de la mousse et pas celui du voisin ?', a: "Parce que la mousse pousse là où l'humidité stagne. L'orientation du toit, l'ombre d'un arbre ou l'âge des tuiles suffisent à faire la différence entre deux maisons voisines." },
];
---
<Layout
  title={title}
  description={description}
  path={path}
  noindex={brouillon}
  ogImage={heroPhoto}
  jsonLd={pageSchema(path, filAriane, {
    pageName: h1,
    description,
    image: heroPhoto,
    service: { name: 'Nettoyage et démoussage de toiture', description },
    faq,
  })}
>
  <Ariane label={filAriane} />

  <section class="hero-page">
    <div class="conteneur hero-page__grille">
      <div class="hero-page__texte">
        <h1>Nettoyage et démoussage de toiture en <em>{site.address.region}</em></h1>
        <p class="hero-page__chapo">
          De la mousse sur les tuiles, des lichens, des traînées noires ? Je nettoie la
          toiture sans l'abîmer, je traite contre la mousse et j'applique un hydrofuge qui
          retarde la repousse.
        </p>
        <ul class="hero-page__points">
          <li><Icone nom="coche" taille={18} />Manuel ou basse pression, selon l'état des tuiles</li>
          <li><Icone nom="coche" taille={18} />Anti-mousse, puis hydrofuge incolore ou coloré</li>
          <li><Icone nom="coche" taille={18} />Faîtage, solins et cheminée contrôlés au passage</li>
        </ul>
        <div class="hero-page__actions">
          <a class="btn btn--rouge btn--lg" href="/devis-gratuit/">Demander un devis<Fleche /></a>
          <a class="btn btn--lg btn--contour" href={`tel:${site.phoneHref}`}>
            <Icone nom="tel" taille={20} />{site.phone}
          </a>
        </div>
      </div>
      <div class="hero-page__media">
        <img
          class="hero-page__photo"
          src={heroPhoto}
          width="1600" height="1200"
          fetchpriority="high" decoding="async"
          alt={`L'artisan sur son échelle pour le nettoyage d'une toiture — ${site.brand}, couvreur en ${site.address.region}`}
        />
        <div class="hero-page__carte">
          <span class="hero-page__pastille"><Icone nom="coche" taille={22} /></span>
          <div>
            <strong>Brosse ou basse pression</strong>
            <span>La tuile est nettoyée, pas décapée.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="reassurance reassurance--plate">
    <div class="conteneur">
      <div class="reassurance__grille">
        {reassurance.map((r) => (
          <div class="reassurance__item">
            <strong>{r.titre}</strong>
            <span>{r.texte}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="conteneur duo">
      <div class="duo__texte">
        <h2>Pourquoi la mousse s'installe sur une toiture</h2>
        <p>
          Un pan orienté au nord, un arbre qui fait de l'ombre, un mur voisin qui garde
          l'humidité : la mousse pousse là où le toit ne sèche pas. Et plus la tuile vieillit,
          plus la mousse s'y accroche.
        </p>
        <h3>Ce que la mousse abîme, au-delà de l'aspect</h3>
        <p>
          La mousse retient l'eau au lieu de la laisser ruisseler. Les tuiles restent humides,
          deviennent poreuses, et le gel finit par les fissurer. Sous la couverture,
          l'humidité gagne les liteaux, puis la charpente.
        </p>
        <h3>À la brosse ou à basse pression, jamais à haute pression</h3>
        <p>
          Le nettoyeur haute pression décape la surface de la tuile et accélère son usure.
          Selon l'état de la couverture, je travaille à la brosse et au grattoir, ou à basse
          pression. C'est plus long, mais la tuile reste entière.
        </p>
      </div>
      <div class="duo__media">
        <img
          src="/photos/toiture-en-tuiles-anciennes-encrassees-avant-nettoyage-simonard-couvreur-77.webp"
          width="675" height="900" loading="lazy" decoding="async"
          alt={`Tuiles encrassées de mousse et de lichen au pied d'une cheminée, avant nettoyage — ${site.brand}, couvreur en ${site.address.region}`}
        />
      </div>
    </div>
  </section>

  <section class="section section--sombre">
    <div class="conteneur duo duo--inverse">
      <div class="duo__texte">
        <h2>Les étapes d'un nettoyage de toiture</h2>
        <ul class="liste-detail">
          {etapes.map((e) => <li><strong>{e.t}</strong> — {e.d}</li>)}
        </ul>
        <a class="btn btn--rouge duo__cta" href="/devis-gratuit/">Demander un devis<Fleche /></a>
      </div>
      <div class="duo__media">
        <img
          src="/photos/toiture-en-tuiles-envahie-de-mousse-avant-demoussage-simonard-couvreur-77.webp"
          width="1200" height="1600" loading="lazy" decoding="async"
          alt={`Toiture en tuiles plates pendant le traitement, le produit mousse sur les tuiles — ${site.brand}, couvreur en ${site.address.region}`}
        />
      </div>
    </div>
  </section>

  <AppelMascotte
    titre="Des tuiles qui verdissent ou qui noircissent ?"
    texte="Appelez-moi : je monte voir l'état des tuiles, je vous dis si un nettoyage suffit ou si certaines sont à remplacer, et vous recevez un devis écrit, détaillé et gratuit."
    note="Devis gratuit, déplacement offert"
    mascotte="face"
    inverse={true}
  />

  <section class="section">
    <div class="conteneur duo">
      <div class="duo__texte">
        <h2>Hydrofuge incolore ou hydrofuge coloré ?</h2>
        <p>
          L'hydrofuge incolore protège la tuile sans changer son aspect. C'est le choix
          habituel sur une toiture en bon état.
        </p>
        <p>
          L'hydrofuge coloré ajoute une teinte à la couverture et ravive une toiture ancienne,
          ternie par les années. Dans les deux cas, il s'applique sur une toiture propre et
          sèche, jamais sur de la mousse.
        </p>
      </div>
      <div class="duo__media">
        <img
          src="/photos/application-dun-traitement-hydrofuge-sur-toiture-simonard-couvreur-77.webp"
          width="733" height="550" loading="lazy" decoding="async"
          alt={`Application d'un traitement au pulvérisateur sur une toiture en tuiles — ${site.brand}, couvreur en ${site.address.region}`}
        />
      </div>
    </div>
  </section>

  <section class="section section--gris">
    <div class="conteneur duo duo--inverse">
      <div class="duo__texte">
        <h2>À quel rythme faire nettoyer sa toiture ?</h2>
        <p>
          Il n'y a pas de règle valable pour tous les toits. Une toiture exposée au sud et
          dégagée reste propre longtemps ; à l'ombre et à l'humidité, elle se couvre de mousse
          en quelques années.
        </p>
        <p>
          Ce qui est sûr, c'est que nettoyer avant que la mousse ait rendu les tuiles poreuses
          coûte beaucoup moins cher que de remplacer la couverture. Je vous donne un rythme
          adapté à votre toit après l'avoir vu.
        </p>
      </div>
      <div class="duo__media">
        <img
          src="/photos/tuiles-encrassees-avant-nettoyage-de-toiture-simonard-couvreur-77.webp"
          width="1200" height="1600" loading="lazy" decoding="async"
          alt={`Toiture en tuiles à moitié nettoyée : tuiles noircies en haut, tuiles propres en bas — ${site.brand}, couvreur en ${site.address.region}`}
        />
      </div>
    </div>
  </section>

  <Faq titre="Vos questions sur le nettoyage et le démoussage" items={faq} gris={false} />

  <!-- ═══ APPEL ══════════════════════════════════════════════════════ -->
  <AppelBandeau
    titre="Une toiture à nettoyer&nbsp;? Le déplacement est gratuit."
    texte="Appelez-moi : je viens voir l'état des tuiles et vous recevez un devis écrit et détaillé, sans engagement."
    points={[
      'Devis et déplacement gratuits',
      'Nettoyage à la brosse ou à basse pression',
      'Garantie décennale',
      'Mon équipe, sans sous-traitance',
    ]}
    mascotte="gauche"
  />
</Layout>
