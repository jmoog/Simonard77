---
import Layout from '../layouts/Layout.astro';
import Icone from '../components/Icones.astro';
import Fleche from '../components/Fleche.astro';
import Ariane from '../components/Ariane.astro';
import Faq from '../components/Faq.astro';
import AppelMascotte from '../components/AppelMascotte.astro';
import { site, reassurance } from '../data/site.js';
import { estPubliee } from '../data/urls.js';
import { pageSchema } from '../data/schema.js';

/**
 * Page « Réparation de toiture » — gabarit dupliqué depuis
 * renovation-refection-de-toiture.astro (mêmes sections, mêmes alternances).
 *
 * Faits utilisés, tous documentés sur l'accueil : intervention rapide en
 * urgence comme sur rendez-vous, bâchage et mise hors d'eau puis recherche
 * de l'origine réelle avant réparation, visite du toit et des combles,
 * garantie décennale, devis écrit poste par poste.
 */
const path = '/reparation-de-toiture/';
const brouillon = !estPubliee(path);

const filAriane = 'Réparation de toiture';

const h1 = 'Réparation de toiture en Seine-et-Marne';
const title = `Réparation de toiture en ${site.address.region} (77) | ${site.brand}`;
const description = `Toit qui fuit, tuiles cassées ou arrachées ? Bâchage si besoin, recherche de l'origine de la fuite et réparation en ${site.address.region}. Devis gratuit ✓ ${site.phone}.`;

const heroPhoto = '/photos/banderole-simonard-sur-chantier-de-toiture-avec-echafaudage-77.webp';

const etapes = [
  { t: 'Bâchage si nécessaire', d: "Si la fuite est active ou le toit ouvert, je bâche d'abord : la maison est hors d'eau le temps de préparer la réparation." },
  { t: 'Recherche de fuite', d: "Sur le toit et dans les combles, je remonte jusqu'au point d'entrée de l'eau, qui n'est presque jamais sous la tache." },
  { t: 'Remplacement des éléments abîmés', d: "Tuiles cassées, ardoises fendues, solins décollés : je remplace à l'identique, avec le même matériau que la couverture existante." },
  { t: 'Contrôle des points singuliers', d: 'Faîtage, rives, noues, pieds de cheminée et fenêtres de toit : ce sont eux qui fuient en premier, je les vérifie tous.' },
  { t: "Reprise de l'étanchéité", d: "Je refais les raccords qui laissent passer l'eau, autour d'une cheminée, d'une fenêtre de toit ou d'un arêtier." },
  { t: 'Vérification et nettoyage', d: "Je contrôle qu'il n'y a plus d'infiltration et je nettoie le chantier avant de partir." },
];

const pannes = [
  { t: 'Tuiles ou ardoises cassées', d: "Un choc, le gel ou le vent suffisent à en casser ou à en déplacer quelques-unes, et l'eau passe." },
  { t: 'Faîtage fissuré', d: "Le mortier du faîtage se fissure avec les années et laisse l'eau s'infiltrer sous les tuiles faîtières." },
  { t: 'Solin de cheminée décollé', d: "La jonction entre la cheminée et la couverture est le point faible du toit : c'est souvent par là que l'eau entre." },
  { t: 'Gouttière bouchée ou percée', d: "L'eau qui ne s'évacue plus déborde et remonte sous les premiers rangs de tuiles au lieu de partir dans la descente." },
  { t: 'Écran de sous-toiture déchiré', d: "Percé ou mal raccordé, il laisse l'humidité arriver directement sur la charpente." },
];

const faq = [
  { q: 'Une petite fuite peut-elle attendre ?', a: "Non. Une infiltration, même légère, humidifie la charpente et l'isolant, et les dégâts grossissent en silence. Plus on attend, plus la réparation coûte cher." },
  { q: 'Intervenez-vous en urgence après une tempête ?', a: "Oui. Je me déplace pour constater les dégâts et bâcher si le toit est ouvert, puis j'organise la réparation." },
  { q: "J'ai une tache au plafond : d'où vient l'eau ?", a: "Rarement de juste au-dessus. L'eau suit un chevron ou un liteau avant de retomber, parfois à plusieurs mètres du point d'entrée. Je passe dans les combles et sur le toit pour remonter jusqu'à la source." },
  { q: 'La réparation est-elle garantie ?', a: 'Oui. Tous mes travaux sont couverts par la garantie décennale, la réparation comme le remplacement.' },
];
---
<Layout
  title={title}
  description={description}
  path={path}
  noindex={brouillon}
  ogImage={heroPhoto}
  jsonLd={pageSchema(path, filAriane, {
    pageName: h1,
    description,
    image: heroPhoto,
    service: { name: 'Réparation de toiture', description },
    faq,
  })}
>
  <Ariane label={filAriane} />

  <section class="hero-page">
    <div class="conteneur hero-page__grille">
      <div class="hero-page__texte">
        <h1>Réparation de toiture en <em>{site.address.region}</em></h1>
        <p class="hero-page__chapo">
          Un toit qui fuit ? Des tuiles cassées ou arrachées par le vent ? J'interviens vite,
          je mets le toit hors d'eau si c'est urgent, puis je cherche l'origine réelle de la
          fuite avant de réparer.
        </p>
        <ul class="hero-page__points">
          <li><Icone nom="coche" taille={18} />Intervention rapide, en urgence comme sur rendez-vous</li>
          <li><Icone nom="coche" taille={18} />Réparation à l'identique : tuile, ardoise, zinc</li>
          <li><Icone nom="coche" taille={18} />Garantie décennale sur les travaux</li>
        </ul>
        <div class="hero-page__actions">
          <a class="btn btn--rouge btn--lg" href="/devis-gratuit/">Demander un devis<Fleche /></a>
          <a class="btn btn--lg btn--contour" href={`tel:${site.phoneHref}`}>
            <Icone nom="tel" taille={20} />{site.phone}
          </a>
        </div>
      </div>
      <div class="hero-page__media">
        <img
          class="hero-page__photo"
          src={heroPhoto}
          width="1200" height="900"
          fetchpriority="high" decoding="async"
          alt={`Banderole Simonard sur un chantier de toiture sous échafaudage — ${site.brand}, couvreur en ${site.address.region}`}
        />
        <div class="hero-page__carte">
          <span class="hero-page__pastille"><Icone nom="coche" taille={22} /></span>
          <div>
            <strong>Bâchage d'urgence</strong>
            <span>Le toit est mis hors d'eau en attendant la réparation.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="reassurance reassurance--plate">
    <div class="conteneur">
      <div class="reassurance__grille">
        {reassurance.map((r) => (
          <div class="reassurance__item">
            <strong>{r.titre}</strong>
            <span>{r.texte}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="conteneur duo">
      <div class="duo__texte">
        <h2>D'où vient la fuite ?</h2>
        <p>
          Une tuile déplacée, un faîtage fissuré, un solin de cheminée décollé, une gouttière
          bouchée qui fait remonter l'eau sous les tuiles : les causes sont nombreuses, et
          rarement à l'aplomb de la tache au plafond. L'eau chemine le long d'un chevron
          avant de retomber.
        </p>
        <h3>Mettre hors d'eau d'abord</h3>
        <p>
          Quand une fuite est active ou que le toit est ouvert, la première chose à faire est
          de bâcher. La maison est protégée, et la réparation s'organise sans précipitation.
        </p>
        <h3>Chercher l'origine, pas la trace</h3>
        <p>
          Je monte sur le toit et je passe dans les combles quand il y a une trace. Reboucher
          là où l'eau apparaît ne sert à rien si elle entre trois mètres plus haut : je répare
          là où elle entre.
        </p>
      </div>
      <div class="duo__media">
        <img
          src="/photos/artisan-simonard-sur-echelle-pour-le-nettoyage-dune-toiture-77.webp"
          width="1600" height="1200" loading="lazy" decoding="async"
          alt={`L'artisan sur son échelle, au pied d'une toiture — ${site.brand}, couvreur en ${site.address.region}`}
        />
      </div>
    </div>
  </section>

  <section class="section section--sombre">
    <div class="conteneur duo duo--inverse">
      <div class="duo__texte">
        <h2>Les étapes d'une réparation de toiture</h2>
        <ul class="liste-detail">
          {etapes.map((e) => <li><strong>{e.t}</strong> — {e.d}</li>)}
        </ul>
        <a class="btn btn--rouge duo__cta" href="/devis-gratuit/">Demander un devis<Fleche /></a>
      </div>
      <div class="duo__media">
        <img
          src="/photos/maison-sous-echafaudage-chantier-de-couverture-simonard-couvreur-77-01.webp"
          width="1200" height="900" loading="lazy" decoding="async"
          alt={`Maison sous échafaudage pendant un chantier de couverture — ${site.brand}, couvreur en ${site.address.region}`}
        />
      </div>
    </div>
  </section>

  <AppelMascotte
    titre="Une tache au plafond, une tuile qui manque ?"
    texte="Appelez-moi : je viens chercher d'où vient l'eau, je bâche si le toit est ouvert, et vous recevez un devis écrit pour la réparation, détaillé poste par poste."
    note="Devis gratuit, déplacement offert"
    mascotte="gauche"
  />

  <section class="section">
    <div class="conteneur duo">
      <div class="duo__texte">
        <h2>Les pannes les plus fréquentes</h2>
        <ul class="liste-detail">
          {pannes.map((p) => <li><strong>{p.t}</strong> — {p.d}</li>)}
        </ul>
        <p>
          Quand c'est la gouttière qui lâche, ce n'est pas la couverture qu'il faut reprendre :
          j'en parle sur la page consacrée à la
          <a href="/installation-remplacement-de-gouttieres/">pose et au remplacement de gouttières</a>.
        </p>
      </div>
      <div class="duo__media">
        <img
          src="/photos/gouttiere-et-descente-en-zinc-sur-chantier-simonard-couvreur-77.webp"
          width="1200" height="900" loading="lazy" decoding="async"
          alt={`Gouttière et descente en zinc posées sur un chantier — ${site.brand}, couvreur en ${site.address.region}`}
        />
      </div>
    </div>
  </section>

  <section class="section section--gris">
    <div class="conteneur duo duo--inverse">
      <div class="duo__texte">
        <h2>Après une tempête ou un orage de grêle</h2>
        <p>
          Tuiles arrachées, ardoises fendues, gouttière décrochée : après un coup de vent,
          appelez-moi. Je viens constater les dégâts, je bâche si le toit est ouvert, et vous
          recevez un devis écrit pour la réparation.
        </p>
        <p>Ce devis, détaillé poste par poste, peut être transmis à votre assurance.</p>
      </div>
      <div class="duo__media">
        <img
          src="/photos/toiture-en-tuiles-renovee-vue-de-la-rue-simonard-couvreur-77.webp"
          width="1600" height="1199" loading="lazy" decoding="async"
          alt={`Toiture en tuiles rénovée, vue depuis la rue — ${site.brand}, couvreur en ${site.address.region}`}
        />
      </div>
    </div>
  </section>

  <Faq titre="Vos questions sur la réparation de toiture" items={faq} gris={false} />

  <section class="appel">
    <div class="conteneur">
      <h2>Une fuite à réparer ? Le déplacement est gratuit.</h2>
      <p>Appelez-moi : je viens voir la toiture, je bâche si c'est nécessaire, et vous recevez un devis écrit et détaillé, sans engagement.</p>
      <ul class="appel__points">
        <li>Devis et déplacement gratuits</li>
        <li>Interlocuteur unique</li>
        <li>Garantie décennale</li>
        <li>Urgences traitées en priorité</li>
      </ul>
      <div class="appel__actions">
        <a class="btn btn--rouge btn--lg" href="/devis-gratuit/">Demander mon devis<Fleche /></a>
        <a class="btn btn--lg btn--clair" href={`tel:${site.phoneHref}`}>
          <Icone nom="tel" taille={20} />{site.phone}
        </a>
      </div>
    </div>
  </section>
</Layout>
