---
import Layout from '../layouts/Layout.astro';
import Icone from '../components/Icones.astro';
import Fleche from '../components/Fleche.astro';
import Ariane from '../components/Ariane.astro';
import Faq from '../components/Faq.astro';
import AppelMascotte from '../components/AppelMascotte.astro';
import { site, reassurance } from '../data/site.js';
import { estPubliee } from '../data/urls.js';
import { pageSchema } from '../data/schema.js';

/**
 * Page de prestation « Installation & remplacement de gouttières ». Rédigée
 * en priorité le 03/09/2026, à la place du pilier « Réfection de
 * zinguerie » : c'est la gouttière, pas le mot « zinguerie », que les gens
 * recherchent — voir la carte correspondante dans PageVille.astro.
 */
const path = '/installation-remplacement-de-gouttieres/';
const brouillon = !estPubliee(path);

const filAriane = 'Installation & remplacement de gouttières';

const h1 = 'Installation et remplacement de gouttières en Seine-et-Marne';
const title = `Installation et remplacement de gouttières en ${site.address.region} (77)`;
const description = `Gouttières en zinc, aluminium ou PVC : pose, remplacement et raccordement des descentes en ${site.address.region}. Devis gratuit ✓ ${site.phone}.`;

const heroPhoto = '/photos/installation-dune-gouttiere-par-lartisan-simonard-couvreur-77.webp';

const etapes = [
  { t: "Dépose de l'ancienne gouttière", d: 'Je retire la gouttière et les crochets existants avant de vérifier le support (chevrons, planche de rive).' },
  { t: "Vérification de la pente d'écoulement", d: "La pente vers la descente est contrôlée et ajustée : c'est elle qui évite les débordements et les stagnations d'eau." },
  { t: 'Pose de la nouvelle gouttière', d: "La gouttière est posée dans le matériau choisi, en respectant l'écartement des crochets." },
  { t: 'Raccordement des descentes', d: "Les descentes sont raccordées et orientées pour évacuer l'eau loin des fondations." },
  { t: 'Étanchéité des jonctions', d: "Angles, jonctions et naissances de descente sont étanchés pour supprimer les fuites." },
  { t: "Test d'écoulement", d: "Je vérifie que l'eau s'évacue correctement avant de considérer le chantier terminé." },
];

const materiaux = [
  { t: 'Le zinc', d: "Matériau traditionnel et durable, qui s'accorde avec une couverture en zinc ou en ardoise." },
  { t: "L'aluminium", d: "Léger, ne rouille pas, disponible dans plusieurs teintes pour s'accorder à la façade." },
  { t: 'Le PVC', d: "Solution économique et rapide à poser, adaptée à un budget serré." },
  { t: 'Le profil : demi-ronde ou à moulures', d: "Le choix du profil dépend du style de la maison — une demi-ronde sur une maison ancienne, une gouttière à moulures sur du pavillon plus récent." },
];

const faq = [
  { q: 'Une gouttière qui déborde est-elle grave ?', a: "Oui : l'eau qui déborde ruisselle le long de la façade et finit par s'infiltrer au niveau des fondations ou du soubassement. Mieux vaut ne pas laisser traîner." },
  { q: 'Quelle est la durée de vie d\'une gouttière en zinc ?', a: "Une gouttière en zinc bien entretenue tient plusieurs dizaines d'années, contre une durée de vie plus courte pour le PVC." },
  { q: 'Faut-il remplacer toute la gouttière ou juste une partie ?', a: "Une fuite ponctuelle sur une gouttière saine se répare localement. Si plusieurs sections sont fissurées, décrochées ou corrodées, le remplacement complet évite de réintervenir sans cesse." },
  { q: 'Peut-on remplacer une gouttière sans toucher à la toiture ?', a: "Oui dans la plupart des cas. Si la couverture est elle-même endommagée, j'en profite pour vérifier les deux en même temps." },
];
---
<Layout
  title={title}
  description={description}
  path={path}
  noindex={brouillon}
  ogImage={heroPhoto}
  jsonLd={pageSchema(path, filAriane, {
    pageName: h1,
    description,
    image: heroPhoto,
    service: { name: 'Installation et remplacement de gouttières', description },
    faq,
  })}
>
  <Ariane label={filAriane} />

  <section class="hero-page">
    <div class="conteneur hero-page__grille">
      <div class="hero-page__texte">
        <h1>Installation et remplacement de gouttières en <em>{site.address.region}</em></h1>
        <p class="hero-page__chapo">
          Gouttière qui déborde, fissurée ou décrochée ? Je pose et je remplace vos
          gouttières en zinc, aluminium ou PVC, descentes comprises.
        </p>
        <ul class="hero-page__points">
          <li><Icone nom="coche" taille={18} />Zinc, aluminium ou PVC</li>
          <li><Icone nom="coche" taille={18} />Raccordement des descentes inclus</li>
          <li><Icone nom="coche" taille={18} />Garantie décennale sur les travaux</li>
        </ul>
        <div class="hero-page__actions">
          <a class="btn btn--rouge btn--lg" href="/devis-gratuit/">Demander un devis<Fleche /></a>
          <a class="btn btn--lg btn--contour" href={`tel:${site.phoneHref}`}>
            <Icone nom="tel" taille={20} />{site.phone}
          </a>
        </div>
      </div>
      <div class="hero-page__media">
        <img
          class="hero-page__photo"
          src={heroPhoto}
          width="1600" height="1200"
          fetchpriority="high" decoding="async"
          alt={`Installation d'une gouttière par l'artisan — ${site.brand}, couvreur en ${site.address.region}`}
        />
        <div class="hero-page__carte">
          <span class="hero-page__pastille"><Icone nom="coche" taille={22} /></span>
          <div>
            <strong>Garantie décennale</strong>
            <span>Tous les travaux de zinguerie sont couverts.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="reassurance reassurance--plate">
    <div class="conteneur">
      <div class="reassurance__grille">
        {reassurance.map((r) => (
          <div class="reassurance__item">
            <strong>{r.titre}</strong>
            <span>{r.texte}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="conteneur duo">
      <div class="duo__texte">
        <h2>Pourquoi remplacer une gouttière plutôt que la réparer</h2>
        <p>
          Des fissures qui reviennent après chaque réparation, une gouttière décrochée
          de son crochet, de la rouille qui perce le métal, des débordements malgré un
          nettoyage régulier : ce sont les signes qu'une réparation ponctuelle ne suffit
          plus.
        </p>
        <h3>Les conséquences d'une gouttière qui ne fait plus son travail</h3>
        <p>
          L'eau qui déborde ruisselle le long de la façade au lieu de s'évacuer, tache le
          mur et finit par s'infiltrer au niveau du soubassement. Une gouttière hors
          service touche donc bien plus que le toit.
        </p>
        <h3>Réparation ponctuelle ou remplacement complet</h3>
        <p>
          Un joint refait ou une section changée suffit souvent sur une gouttière encore
          saine. Quand plusieurs points lâchent en même temps, mieux vaut remplacer
          l'ensemble plutôt que de réintervenir chaque saison.
        </p>
      </div>
      <div class="duo__media">
        <img
          src="/photos/gouttiere-et-descente-en-zinc-sur-chantier-simonard-couvreur-77.webp"
          width="1600" height="1200" loading="lazy" decoding="async"
          alt={`Gouttière et descente en zinc posées sur un chantier de couverture — ${site.brand}, couvreur en ${site.address.region}`}
        />
      </div>
    </div>
  </section>

  <section class="section section--sombre">
    <div class="conteneur duo duo--inverse">
      <div class="duo__texte">
        <h2>Les étapes d'une pose de gouttière</h2>
        <ul class="liste-detail">
          {etapes.map((e) => <li><strong>{e.t}</strong> — {e.d}</li>)}
        </ul>
        <a class="btn btn--rouge duo__cta" href="/devis-gratuit/">Demander un devis<Fleche /></a>
      </div>
      <div class="duo__media">
        <img
          src="/photos/installation-dune-gouttiere-par-lartisan-simonard-couvreur-77.webp"
          width="1200" height="900" loading="lazy" decoding="async"
          alt={`L'artisan pose une gouttière — ${site.brand}, couvreur en ${site.address.region}`}
        />
      </div>
    </div>
  </section>

  <AppelMascotte
    titre="Une gouttière à remplacer ?"
    note="Déplacement offert"
    mascotte="gauche"
  />

  <section class="section">
    <div class="conteneur duo">
      <div class="duo__texte">
        <h2>Zinc, aluminium ou PVC ?</h2>
        <ul class="liste-detail">
          {materiaux.map((m) => <li><strong>{m.t}</strong> — {m.d}</li>)}
        </ul>
        <p>J'en discute avec vous lors du diagnostic, selon la couverture existante et le budget souhaité.</p>
      </div>
      <div class="duo__media">
        <img
          src="/photos/vue-aerienne-toiture-ardoise-et-tourelle-terminees-simonard-couvreur-77.webp"
          width="1600" height="1200" loading="lazy" decoding="async"
          alt={`Vue aérienne d'une toiture avec sa zinguerie terminée — ${site.brand}, couvreur en ${site.address.region}`}
        />
      </div>
    </div>
  </section>

  <section class="section section--gris">
    <div class="conteneur duo duo--inverse">
      <div class="duo__texte">
        <h2>Gouttières et infiltrations : un lien direct</h2>
        <p>
          Une gouttière bouchée ou percée est l'une des causes les plus fréquentes
          d'infiltration, sans que la couverture elle-même soit en cause. Si vous
          constatez une fuite au niveau du toit, voir aussi la page
          <a href="/reparation-de-toiture/">réparation de toiture</a>.
        </p>
      </div>
      <div class="duo__media">
        <img
          src="/photos/toiture-en-tuiles-renovee-vue-de-la-rue-simonard-couvreur-77.webp"
          width="1600" height="1200" loading="lazy" decoding="async"
          alt={`Toiture en tuiles avec gouttière, vue depuis la rue — ${site.brand}, couvreur en ${site.address.region}`}
        />
      </div>
    </div>
  </section>

  <Faq titre="Vos questions sur les gouttières" items={faq} gris={false} />

  <section class="appel">
    <div class="conteneur">
      <h2>Une gouttière hors service ne s'arrange pas seule</h2>
      <p>Déplacement et chiffrage offerts, sans engagement de votre part.</p>
      <ul class="appel__points">
        <li>Devis et déplacement gratuits</li>
        <li>Interlocuteur unique</li>
        <li>Garantie décennale</li>
        <li>Urgences traitées en priorité</li>
      </ul>
      <div class="appel__actions">
        <a class="btn btn--rouge btn--lg" href="/devis-gratuit/">Demander mon devis<Fleche /></a>
        <a class="btn btn--lg btn--clair" href={`tel:${site.phoneHref}`}>
          <Icone nom="tel" taille={20} />{site.phone}
        </a>
      </div>
    </div>
  </section>
</Layout>
