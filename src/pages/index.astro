---
import Layout from '../layouts/Layout.astro';
import Icone from '../components/Icones.astro';
import Fleche from '../components/Fleche.astro';
import CartePrestation from '../components/CartePrestation.astro';
import AppelMascotte from '../components/AppelMascotte.astro';
import { site, reassurance, communes } from '../data/site.js';
import { estPubliee } from '../data/urls.js';
import { villes } from '../data/villes.js';
import { pageSchema } from '../data/schema.js';

// Balises retravaillées le 3 septembre 2026. L'accueil vise deux requêtes sur
// une seule URL : « couvreur Claye-Souilly » en principal (c'est l'adresse du
// bureau et de la fiche Google, et aucun concurrent de la SERP ne cible la
// commune) et « couvreur 77 » / Seine-et-Marne en secondaire. Les deux
// figurent dans le title, le H1, la meta, le premier paragraphe et la section
// zone d'intervention. Title 50 caractères, meta 148 : rien n'est tronqué.
const title = `Couvreur ${site.address.city} | Couvreur ${site.address.department} – ${site.brand}`;
const description = `Couvreur zingueur à ${site.address.city} et dans toute la ${site.address.region} (${site.address.department}) : couverture, entretien, zinguerie, isolation. Devis gratuit ✓ ${site.phone}`;

const heroPhoto = '/photos/vue-aerienne-maison-avec-toiture-ardoise-terminee-simonard-couvreur-77.webp';

// Les rubriques du site. `href` pointe vers la page PUBLIÉE la plus proche
// de la rubrique (celle que les gens recherchent : nettoyage, gouttières,
// réparation), pas forcément vers la page pilier du silo. La carte ne devient
// cliquable que si cette page est marquée `ok` dans data/urls.js (voir
// CartePrestation.astro).
const rubriques = [
  {
    titre: 'Couverture & rénovation',
    texte: "Remplacement complet ou partiel de votre couverture, réparation de fuites, urgences. Je travaille la tuile, l'ardoise, le zinc, le bac acier et le shingle.",
    icone: '/icones/couverture.webp',
    href: '/renovation-refection-de-toiture/',
    items: ['Tuile', 'Ardoise', 'Zinc', 'Bac acier', 'Fuites'],
  },
  {
    titre: 'Nettoyage de toiture',
    texte: "Nettoyage et démoussage, traitement anti-mousse, hydrofuge incolore ou coloré : l'entretien régulier est ce qui repousse le plus longtemps une réfection complète.",
    icone: '/icones/entretien.webp',
    href: '/nettoyage-demoussage-de-toiture/',
    items: ['Démoussage', 'Anti-mousse', 'Hydrofuge'],
  },
  {
    titre: 'Zinguerie',
    texte: "Gouttières, descentes, noues, solins et pieds de cheminée. Tout ce qui conduit l'eau hors de votre toit, façonné et posé sur mesure.",
    icone: '/icones/zinguerie.webp',
    href: '/installation-remplacement-de-gouttieres/',
    items: ['Gouttières', 'Noues', 'Cheminée', 'Rives'],
  },
  {
    titre: 'Isolation',
    texte: "Combles perdus par soufflage, rampants par l'intérieur ou par l'extérieur (sarking), pignons, bardage PVC. On intervient sur le toit : autant en profiter.",
    icone: '/icones/isolation.webp',
    href: '/isolation-de-toiture/',
    items: ['Combles', 'Rampants', 'Pignons', 'Bardage'],
  },
  {
    titre: 'Étanchéité',
    texte: "Toits-terrasses et étanchéité bitumineuse : membrane, relevés, évacuations. Une reprise ciblée coûte toujours moins cher qu'un plafond à refaire.",
    icone: '/icones/etancheite.webp',
    href: '/etancheite-toit-terrasse/',
    items: ['Toit-terrasse', 'Bitume', 'Relevés'],
  },
  {
    titre: 'Urgences & recherche de fuite',
    texte: "Une infiltration, des tuiles déplacées ou cassées : j'interviens pour bâcher et mettre hors d'eau, puis je cherche l'origine réelle du problème avant de réparer.",
    icone: '/icones/reparation.webp',
    href: '/reparation-de-toiture/',
    items: ['Bâchage', 'Infiltration', "Mise hors d'eau"],
  },
];

const etapes = [
  { titre: 'Votre appel', texte: "Vous m'expliquez ce que vous avez constaté. Je vous dis tout de suite si cela demande une visite ou si la réponse tient en trois minutes." },
  { titre: 'La visite', texte: 'Je monte voir la toiture, je passe dans les combles quand il y a une trace, et je constate au lieu de supposer. Le déplacement est gratuit.' },
  { titre: 'Le devis écrit', texte: 'Un devis détaillé poste par poste : surfaces, matériaux, dépose et évacuation, échafaudage. Comparable, et sans engagement.' },
  { titre: 'Le chantier', texte: 'Une date fixée, un chantier protégé et nettoyé chaque soir. Les travaux sont couverts par la garantie décennale.' },
];

---
<Layout
  title={title}
  description={description}
  path="/"
  jsonLd={pageSchema('/', 'Accueil', {
    pageName: `${site.brand} — couvreur zingueur à ${site.address.city} et en ${site.address.region}`,
    description,
    image: heroPhoto,
  })}
>
  <!-- ═══ HERO ═══════════════════════════════════════════════════════ -->
  <section class="hero">
    <div class="hero__media">
      <img
        src={heroPhoto}
        width="1444" height="993"
        fetchpriority="high" decoding="async"
        alt={`Toiture en ardoise entièrement refaite, vue aérienne — ${site.brand}, couvreur à ${site.address.city} (${site.address.region})`}
      />
    </div>
    <div class="hero__inner">
      <div class="conteneur">
        <div class="hero__carte">
          <h1><em>{site.brand}</em>, couvreur à <span class="nowrap">{site.address.city} ({site.address.department})</span></h1>
          <p class="hero__texte">
            Entreprise de couverture artisanale, nous entretenons, réparons et rénovons votre
            toiture dans tout le nord de la {site.address.region}. Compétence, expérience, amour
            du travail bien fait : mon équipe et moi plaçons la satisfaction du client au cœur
            de chaque chantier.
          </p>
          <div class="hero__actions">
            <a class="btn btn--rouge btn--lg" href="/devis-gratuit/">Demander un devis<Fleche /></a>
            <a class="btn btn--lg btn--clair" href={`tel:${site.phoneHref}`}>
              <Icone nom="tel" taille={20} />{site.phone}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ RÉASSURANCE ════════════════════════════════════════════════ -->
  <section class="reassurance">
    <div class="conteneur">
      <div class="reassurance__grille">
        {reassurance.map((r) => (
          <div class="reassurance__item">
            <strong>{r.titre}</strong>
            <span>{r.texte}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ PRESTATIONS ════════════════════════════════════════════════ -->
  <section class="section">
    <div class="conteneur">
      <div class="chapeau">
        <h2>Mes prestations de couvreur à <span class="nowrap">{site.address.city}</span></h2>
        <p>
          De la simple tuile cassée à la réfection complète : couverture, zinguerie, isolation
          et étanchéité, réalisées par mon équipe, sans sous-traitance.
        </p>
      </div>
      <div class="prestations">
        {rubriques.map((r) => <CartePrestation {...r} />)}
      </div>
    </div>
  </section>

  <AppelMascotte
    mascotte="gauche"
    titre="Demandez l'intervention de votre couvreur près de chez vous"
    texte={`J'interviens rapidement, en urgence comme sur rendez-vous, à ${site.address.city} et dans toutes les communes proches, pour entretenir, réparer ou rénover votre toiture.`}
    note="Devis gratuit, déplacement offert"
  />

  <!-- ═══ ARTISAN ════════════════════════════════════════════════════ -->
  <section class="section section--gris">
    <div class="conteneur artisan">
      <div class="artisan__media">
        <img
          src="/photos/portrait-kenny-simonard-couvreur-devant-pavillon-77-02.webp"
          width="864" height="1152" loading="lazy" decoding="async"
          alt={`${site.founder}, artisan couvreur, devant un pavillon en chantier en ${site.address.region}`}
        />
      </div>
      <div class="artisan__texte">
        <h2>Couvreur depuis deux générations</h2>
        <p>
          Le métier, je l'ai appris sur les chantiers, aux côtés de la génération d'avant : un
          savoir-faire artisanal qui se transmet et qui s'affine. Tuiles plates ou mécaniques,
          ardoise, zinc, bac acier, shingle — je connais les matériaux de couverture, leurs
          contraintes et leur mise en œuvre.
        </p>
        <p>
          Avec cette expérience, j'interviens à {site.address.city} et dans les communes
          alentour sur n'importe quel type de toiture, pour l'entretenir, la réparer ou la
          rénover : couverture, zinguerie, isolation et charpente. Mon équipe et moi mettons la
          même exigence dans le remplacement de quelques tuiles que dans une réfection complète.
        </p>
        <a class="btn btn--bleu" href="/devis-gratuit/">Me contacter<Fleche /></a>
      </div>
    </div>
  </section>

  <!-- ═══ ENTRETIEN ══════════════════════════════════════════════════ -->
  <section class="section">
    <div class="conteneur duo">
      <div class="duo__texte">
        <h2>L'expert du nettoyage de toiture en {site.address.region}</h2>
        <p>
          Entretenir sa toiture, c'est retirer régulièrement les mousses, les lichens et les
          végétaux qui s'y installent : ils rendent les tuiles poreuses, retiennent l'eau et
          finissent par les fissurer. Pour cela, j'utilise des techniques adaptées à chaque
          couverture, qui nettoient la toiture sans l'abîmer.
        </p>
        <p>
          Nettoyage basse pression ou manuel selon l'état des tuiles, traitement anti-mousse,
          puis hydrofuge — incolore ou coloré — qui retarde la repousse et fait ruisseler l'eau.
          J'en profite toujours pour contrôler les points sensibles : faîtage, solins, pieds de
          cheminée. Ce sont eux qui fuient en premier.
        </p>
      </div>
      <div class="duo__media">
        <img
          src="/photos/artisan-simonard-sur-echelle-pour-le-nettoyage-dune-toiture-77.webp"
          width="1600" height="1200" loading="lazy" decoding="async"
          alt={`Nettoyage d'une toiture en tuiles depuis une échelle — ${site.brand}, couvreur à ${site.address.city}`}
        />
      </div>
    </div>
  </section>

  <!-- ═══ ZINGUERIE ══════════════════════════════════════════════════ -->
  <section class="section section--sombre">
    <div class="conteneur duo duo--inverse">
      <div class="duo__texte">
        <h2>Zinguerie en {site.address.region} ({site.address.department})</h2>
        <p>
          Gouttières, descentes, noues, chéneaux, solins et pieds de cheminée : la zinguerie,
          c'est tout ce qui conduit l'eau hors de votre toit. Un ouvrage percé, déformé ou
          simplement obstrué, et l'eau part là où elle ne devrait pas — sur la façade, dans
          le mur, puis dans les fondations.
        </p>
        <p>
          Je façonne et je pose ces ouvrages en zinc, en aluminium ou en PVC : dépose de
          l'existant, pose des crochets, réglage des pentes, soudure des jonctions. Que le
          chantier soit à {site.address.city}, à Mitry-Mory ou à Lagny-sur-Marne, les pièces
          sont façonnées aux cotes relevées sur place. Et je vous dis franchement quand une
          gouttière se répare plutôt qu'elle ne se remplace.
        </p>
        <a class="btn btn--rouge duo__cta" href="/devis-gratuit/">Demander un devis<Fleche /></a>
      </div>
      <div class="duo__media">
        <img
          src="/photos/gouttiere-et-descente-en-zinc-sur-chantier-simonard-couvreur-77.webp"
          width="1200" height="900" loading="lazy" decoding="async"
          alt={`Gouttière en zinc et sa descente soudée, posées sur un chantier — ${site.brand}, couvreur zingueur en ${site.address.region}`}
        />
      </div>
    </div>
  </section>

  <!-- ═══ ÉTAPES ═════════════════════════════════════════════════════ -->
  <section class="section section--gris">
    <div class="conteneur">
      <div class="chapeau">
        <h2>De votre appel à la fin du chantier</h2>
        <p>Quatre étapes, sans mauvaise surprise et sans engagement de votre part.</p>
      </div>
      <ol class="etapes">
        {etapes.map((e) => (
          <li class="etape">
            <h3>{e.titre}</h3>
            <p>{e.texte}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ═══ ZONE D'INTERVENTION ════════════════════════════════════════ -->
  <section class="section section--ciel">
    <div class="conteneur">
      <div class="chapeau">
        <h2>Couvreur 77 : le nord de la {site.address.region} et au-delà</h2>
        <p>
          J'interviens autour de {site.address.city}, sur tout le nord du département et dans
          les communes limitrophes. Si la vôtre n'est pas dans la liste, appelez-moi : elle est
          probablement dans ma tournée.
        </p>
      </div>
      <ul class="communes">
        {communes.map((c) => {
          // Lien vers la page ville dès qu'elle est publiée (data/urls.js),
          // texte simple sinon : jamais de lien vers une page absente.
          const cible = villes.find((v) => v.nom === c);
          const href = cible && estPubliee(cible.path) ? cible.path : null;
          return (
            <li class={c === site.address.city ? 'est-bureau' : undefined}>
              {href ? <a href={href}>{c}</a> : c}
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- ═══ APPEL FINAL ════════════════════════════════════════════════
       Même encart que plus haut, avec l'autre mascotte (`face`, pouce à
       gauche → montage inversé) pour que le bloc ne semble pas recopié. -->
  <AppelMascotte
    mascotte="face"
    inverse
    titre="Une toiture à voir ? Le déplacement est gratuit."
    texte="Un toit qui fuit, des tuiles cassées, une gouttière qui déborde ? Appelez-moi : je viens voir la toiture et vous recevez un devis écrit et détaillé."
    note="Garantie décennale sur tous les travaux"
  />
</Layout>
