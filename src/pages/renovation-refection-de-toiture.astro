---
import Layout from '../layouts/Layout.astro';
import Icone from '../components/Icones.astro';
import Fleche from '../components/Fleche.astro';
import Ariane from '../components/Ariane.astro';
import Faq from '../components/Faq.astro';
import AppelMascotte from '../components/AppelMascotte.astro';
import { site, reassurance } from '../data/site.js';
import { estPubliee } from '../data/urls.js';
import { pageSchema } from '../data/schema.js';

/**
 * Page « Rénovation & réfection de toiture » — GABARIT DE RÉFÉRENCE des
 * pages de prestation : fil d'Ariane → hero deux colonnes → réassurance →
 * quatre sections en duo à fonds alternés (encart mascotte après la 2e) →
 * FAQ → bandeau d'appel.
 *
 * Rédaction : première personne, phrases courtes, vocabulaire du métier.
 * Tout ce qui est affirmé sur l'entreprise vient de data/site.js ou de
 * l'accueil (équipe sans sous-traitance, devis poste par poste, chantier
 * protégé et nettoyé chaque soir, visite du toit et des combles). Le reste
 * est de l'explication de métier, jamais une promesse chiffrée.
 *
 * Lien interne : uniquement vers des pages `status: 'ok'` dans data/urls.js.
 */
const path = '/renovation-refection-de-toiture/';
const brouillon = !estPubliee(path);

const filAriane = 'Rénovation & réfection de toiture';

const h1 = 'Rénovation de toiture en Seine-et-Marne';
const title = `Rénovation et réfection de toiture en ${site.address.region} (77)`;
const description = `Toiture usée, tuiles qui glissent, fuites à répétition ? Réfection partielle ou remplacement complet en ${site.address.region} : tuile, ardoise, zinc. Devis gratuit ✓ ${site.phone}.`;

const heroPhoto = '/photos/vue-aerienne-toiture-ardoise-et-tourelle-terminees-simonard-couvreur-77.webp';

const etapes = [
  { t: "Dépose de l'ancienne couverture", d: "Je retire tuiles, ardoises ou plaques et j'évacue les gravats au fur et à mesure. Le chantier est protégé et nettoyé chaque soir." },
  { t: 'Écran de sous-toiture', d: "Il protège la charpente de l'humidité et de la poussière, et retient l'eau qui passerait sous une tuile déplacée." },
  { t: 'Liteaunage', d: "Je pose des liteaux neufs à l'écartement du matériau choisi : c'est ce qui donne des rangs droits et réguliers." },
  { t: 'Pose de la couverture', d: 'Rang par rang, en soignant les recouvrements et les points singuliers : faîtage, rives, noues, arêtiers.' },
  { t: 'Zinguerie', d: "Gouttières, descentes et solins sont refaits ou raccordés à la couverture neuve, pour que l'eau sorte du toit sans détour." },
  { t: 'Finitions et nettoyage', d: 'Je nettoie le chantier et je vérifie les abords avant de partir.' },
];

const materiaux = [
  { t: 'La tuile plate', d: 'Le format court et traditionnel des maisons anciennes, souvent imposé dans les secteurs protégés.' },
  { t: 'La tuile mécanique', d: "Elle s'emboîte, se pose plus vite et pèse moins lourd sur la charpente, tout en gardant l'aspect d'un toit en tuile." },
  { t: "L'ardoise", d: 'Naturelle et très durable, elle convient aux fortes pentes et reste exigée par certains règlements locaux.' },
  { t: 'Le zinc à joint debout', d: 'Des feuilles assemblées par pliage, sans fixation visible : le bon choix sur une faible pente ou une forme de toit compliquée.' },
  { t: 'Le bac acier', d: 'Économique et rapide à poser, pour une dépendance, une extension ou un bâtiment agricole.' },
  { t: 'Le shingle', d: 'Des plaques bitumées, légères, pour un abri de jardin ou une annexe à faible pente.' },
];

const faq = [
  { q: 'Faut-il refaire toute la toiture, ou une réparation suffit-elle ?', a: "Tout dépend de l'étendue de l'usure. Quelques tuiles cassées se remplacent ; une couverture usée sur tout le pan se refait. Je tranche après être monté sur le toit, pas avant." },
  { q: 'Combien de temps dure une réfection de toiture ?', a: 'Cela dépend de la surface, de la pente et du matériau. La durée est indiquée sur le devis, et la date du chantier est fixée avec vous.' },
  { q: 'Faut-il une autorisation de la mairie pour refaire sa toiture ?', a: "Une déclaration préalable de travaux est nécessaire dès que l'aspect extérieur change : matériau, couleur ou forme du toit. Refaire à l'identique en demande rarement, mais chaque commune a ses règles : renseignez-vous auprès du service urbanisme de votre mairie avant le chantier." },
  { q: 'La maison est-elle protégée pendant les travaux ?', a: "Oui. Tant que la couverture neuve n'est pas posée, le toit est bâché, et le chantier est protégé et nettoyé chaque soir." },
];
---
<Layout
  title={title}
  description={description}
  path={path}
  noindex={brouillon}
  ogImage={heroPhoto}
  jsonLd={pageSchema(path, filAriane, {
    pageName: h1,
    description,
    image: heroPhoto,
    service: { name: 'Rénovation et réfection de toiture', description },
    faq,
  })}
>
  <!-- ═══ FIL D'ARIANE ═══════════════════════════════════════════════ -->
  <Ariane label={filAriane} />

  <!-- ═══ HERO ═══════════════════════════════════════════════════════ -->
  <section class="hero-page">
    <div class="conteneur hero-page__grille">
      <div class="hero-page__texte">
        <h1>Rénovation de toiture en <em>{site.address.region}</em></h1>
        <p class="hero-page__chapo">
          Des tuiles qui glissent, de la mousse partout, des fuites qui reviennent après
          chaque réparation : à un moment, rafistoler ne suffit plus. Je refais votre
          couverture, en partie ou en totalité, et je vous dis avant de commencer laquelle
          des deux s'impose.
        </p>
        <ul class="hero-page__points">
          <li><Icone nom="coche" taille={18} />Réfection partielle ou remplacement complet</li>
          <li><Icone nom="coche" taille={18} />Tuile, ardoise, zinc, bac acier ou shingle</li>
          <li><Icone nom="coche" taille={18} />Garantie décennale sur tous les travaux</li>
        </ul>
        <div class="hero-page__actions">
          <a class="btn btn--rouge btn--lg" href="/devis-gratuit/">Demander un devis<Fleche /></a>
          <a class="btn btn--lg btn--contour" href={`tel:${site.phoneHref}`}>
            <Icone nom="tel" taille={20} />{site.phone}
          </a>
        </div>
      </div>
      <div class="hero-page__media">
        <img
          class="hero-page__photo"
          src={heroPhoto}
          width="1442" height="989"
          fetchpriority="high" decoding="async"
          alt={`Toiture en ardoise et tourelle terminées, vue aérienne — ${site.brand}, couvreur en ${site.address.region}`}
        />
        <div class="hero-page__carte">
          <span class="hero-page__pastille"><Icone nom="coche" taille={22} /></span>
          <div>
            <strong>Interlocuteur unique</strong>
            <span>Mon équipe et moi, sans sous-traitance.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ RÉASSURANCE ════════════════════════════════════════════════ -->
  <section class="reassurance reassurance--plate">
    <div class="conteneur">
      <div class="reassurance__grille">
        {reassurance.map((r) => (
          <div class="reassurance__item">
            <strong>{r.titre}</strong>
            <span>{r.texte}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ 1. LE DIAGNOSTIC ═══════════════════════════════════════════ -->
  <section class="section">
    <div class="conteneur duo">
      <div class="duo__texte">
        <h2>Réparer, rénover ou remplacer votre toiture ?</h2>
        <p>
          Une tuile cassée, ça se remplace. Mais quand la tuile est devenue poreuse sur tout
          le pan, que les fixations lâchent et qu'il n'y a plus d'écran sous la couverture,
          ce n'est plus une tuile qu'il faut changer : c'est la couverture qui arrive en fin
          de vie.
        </p>
        <h3>Réfection partielle ou remplacement complet</h3>
        <p>
          La réfection partielle reprend le pan abîmé et laisse le reste en place. Le
          remplacement complet dépose toute la couverture, pose un écran de sous-toiture
          neuf et repart sur du liteau neuf. Le premier suffit quand l'usure est localisée ;
          le second s'impose quand elle est générale, ou quand la charpente doit être mise
          à nu.
        </p>
        <h3>Ce que je regarde avant de vous répondre</h3>
        <p>
          Je monte sur le toit et je passe dans les combles : état des liteaux, de la
          charpente, ventilation, traces d'humidité. Je constate au lieu de supposer, et je
          vous dis ensuite si une réparation suffit ou s'il faut refaire.
        </p>
      </div>
      <div class="duo__media">
        <img
          src="/photos/pavillon-vue-densemble-du-chantier-de-couverture-simonard-couvreur-77.webp"
          width="1600" height="1200" loading="lazy" decoding="async"
          alt={`Vue d'ensemble d'un chantier de couverture sur un pavillon — ${site.brand}, couvreur en ${site.address.region}`}
        />
      </div>
    </div>
  </section>

  <!-- ═══ 2. LES ÉTAPES DU CHANTIER ══════════════════════════════════ -->
  <section class="section section--sombre">
    <div class="conteneur duo duo--inverse">
      <div class="duo__texte">
        <h2>Les étapes d'un remplacement de toiture</h2>
        <p>Un remplacement complet suit toujours le même ordre :</p>
        <ul class="liste-detail">
          {etapes.map((e) => <li><strong>{e.t}</strong> — {e.d}</li>)}
        </ul>
        <a class="btn btn--rouge duo__cta" href="/devis-gratuit/">Demander un devis<Fleche /></a>
      </div>
      <div class="duo__media">
        <img
          src="/photos/banderole-simonard-sur-chantier-de-toiture-avec-echafaudage-77.webp"
          width="1200" height="900" loading="lazy" decoding="async"
          alt={`Banderole Simonard sur un chantier de toiture sous échafaudage — ${site.brand}, couvreur en ${site.address.region}`}
        />
      </div>
    </div>
  </section>

  <AppelMascotte
    titre="Votre toiture a fait son temps ?"
    texte="Appelez-moi : je monte sur le toit, je passe dans les combles, et je vous dis si une réfection partielle suffit ou s'il faut tout remplacer. Le devis est écrit, poste par poste, sans engagement."
    note="Devis gratuit, déplacement offert"
    mascotte="face"
    inverse={true}
  />

  <!-- ═══ 3. LES MATÉRIAUX ═══════════════════════════════════════════ -->
  <section class="section">
    <div class="conteneur duo">
      <div class="duo__texte">
        <h2>Quel matériau pour votre nouvelle couverture ?</h2>
        <p>Le choix dépend de la pente, du style de la maison et, souvent, de ce qu'autorise la commune :</p>
        <ul class="liste-detail">
          {materiaux.map((m) => <li><strong>{m.t}</strong> — {m.d}</li>)}
        </ul>
        <!-- Maillage interne : les liens vers les pages matériau (tuile,
             ardoise, zinc, bac acier, shingle) s'ajoutent ici quand elles
             passent à 'ok' dans data/urls.js — jamais avant. -->
        <p>On en parle lors de la visite, et le devis détaille chaque option, poste par poste.</p>
      </div>
      <div class="duo__media">
        <img
          src="/photos/remplacement-de-toiture-en-cours-sur-pavillon-simonard-couvreur-77.webp"
          width="1600" height="1199" loading="lazy" decoding="async"
          alt={`Remplacement d'une toiture en cours sur un pavillon — ${site.brand}, couvreur en ${site.address.region}`}
        />
      </div>
    </div>
  </section>

  <!-- ═══ 4. L'ISOLATION ═════════════════════════════════════════════ -->
  <section class="section section--gris">
    <div class="conteneur duo duo--inverse">
      <div class="duo__texte">
        <h2>Le toit ouvert, le bon moment pour isoler</h2>
        <p>
          Quand la charpente est à nu, poser ou renforcer l'isolation coûte moins cher et va
          plus vite que de rouvrir le toit plus tard.
        </p>
        <p>
          Rampants, combles perdus, sarking : si votre isolation a fait son temps, je vous le
          dis pendant la visite et je l'intègre au même devis. On intervient sur le toit,
          autant en profiter.
        </p>
      </div>
      <div class="duo__media">
        <img
          src="/photos/isolation-en-laine-de-verre-entre-les-liteaux-simonard-couvreur-77.webp"
          width="1600" height="1200" loading="lazy" decoding="async"
          alt={`Isolation en laine de verre posée entre les liteaux — ${site.brand}, couvreur en ${site.address.region}`}
        />
      </div>
    </div>
  </section>

  <Faq titre="Vos questions sur la rénovation de toiture" items={faq} gris={false} />

  <!-- ═══ APPEL ══════════════════════════════════════════════════════ -->
  <section class="appel">
    <div class="conteneur">
      <h2>Une toiture à refaire ? Le déplacement est gratuit.</h2>
      <p>Appelez-moi : je monte voir le toit et vous recevez un devis écrit et détaillé, sans engagement.</p>
      <ul class="appel__points">
        <li>Devis et déplacement gratuits</li>
        <li>Interlocuteur unique</li>
        <li>Garantie décennale</li>
        <li>Urgences traitées en priorité</li>
      </ul>
      <div class="appel__actions">
        <a class="btn btn--rouge btn--lg" href="/devis-gratuit/">Demander mon devis<Fleche /></a>
        <a class="btn btn--lg btn--clair" href={`tel:${site.phoneHref}`}>
          <Icone nom="tel" taille={20} />{site.phone}
        </a>
      </div>
    </div>
  </section>
</Layout>
