---
import Layout from '../layouts/Layout.astro';
import Icone from '../components/Icones.astro';
import Fleche from '../components/Fleche.astro';
import Ariane from '../components/Ariane.astro';
import Faq from '../components/Faq.astro';
import AppelMascotte from '../components/AppelMascotte.astro';
import { site, reassurance } from '../data/site.js';
import { estPubliee } from '../data/urls.js';
import { pageSchema } from '../data/schema.js';

/**
 * Page pilier du silo « couverture » — et GABARIT DE RÉFÉRENCE des pages de
 * prestation. Texte rédigé le 03/09/2026, à partir des seuls faits
 * documentés dans data/site.js (rien sur l'entreprise n'est inventé).
 */
const path = '/renovation-refection-de-toiture/';
const brouillon = !estPubliee(path);

const filAriane = 'Rénovation & réfection de toiture';

const h1 = 'Rénovation de toiture en Seine-et-Marne';
const title = `Rénovation et réfection de toiture en ${site.address.region} (77)`;
const description = `Réfection partielle ou remplacement complet de votre couverture en ${site.address.region} : dépose, écran sous-toiture, tuile, ardoise, zinc. Devis gratuit ✓ ${site.phone}.`;

const heroPhoto = '/photos/vue-aerienne-toiture-ardoise-et-tourelle-terminees-simonard-couvreur-77.webp';

const etapes = [
  { t: "Dépose de l'ancienne couverture", d: "Je retire les tuiles, ardoises ou plaques existantes et j'évacue les gravats au fur et à mesure du chantier." },
  { t: "Pose de l'écran sous-toiture", d: 'Une sous-toiture respirante protège la charpente de l\'humidité avant la pose des liteaux.' },
  { t: 'Liteaunage', d: "Les liteaux sont posés à l'écartement du matériau choisi, pour un calepinage régulier d'un bout à l'autre du pan." },
  { t: 'Pose de la couverture', d: 'Tuiles, ardoises ou zinc sont posés rang par rang, en respectant les recouvrements et les points singuliers : faîtage, rives, noues.' },
  { t: 'Zinguerie', d: "Gouttières, descentes et solins sont refaits ou raccordés à la nouvelle couverture pour que l'eau soit évacuée correctement." },
  { t: 'Finitions et nettoyage', d: 'Le chantier est nettoyé, les abords vérifiés, et je fais le tour du toit avec vous avant de partir.' },
];

const materiaux = [
  { t: 'La tuile plate', d: "Aspect traditionnel, format court et pose dense — c'est la tuile des toitures anciennes et des zones où le PLU impose ce rendu." },
  { t: 'La tuile mécanique', d: "Emboîtement qui accélère la pose et allège la charpente, tout en gardant l'aspect d'une toiture en tuile." },
  { t: "L'ardoise", d: 'Matériau naturel et durable, souvent imposé par le règlement local sur les toitures à forte pente.' },
  { t: 'Le zinc à joint debout', d: 'Étanchéité sans jointoiement apparent, adapté aux faibles pentes et aux formes de toit complexes.' },
  { t: 'Le bac acier', d: 'Solution économique et rapide à poser, pour une dépendance, une extension ou un bâtiment agricole.' },
];

const faq = [
  { q: 'Quand faut-il remplacer sa toiture plutôt que la réparer ?', a: "Si les tuiles se descellent ou se cassent régulièrement, si la mousse recouvre une grande partie du pan, ou si la charpente montre des traces d'humidité, la réparation ponctuelle ne suffit plus. Un diagnostic sur place permet de trancher." },
  { q: 'Combien de temps dure un remplacement de toiture ?', a: 'Cela dépend de la surface, de la pente et du matériau choisi. Je vous donne une durée précise après le diagnostic, inscrite dans le devis.' },
  { q: 'Faut-il une autorisation pour refaire sa toiture ?', a: "Une déclaration préalable de travaux est nécessaire dès que l'aspect extérieur change (matériau, couleur, forme). Je peux vous indiquer les pièces à fournir selon votre commune." },
  { q: 'La maison reste-t-elle à découvert pendant les travaux ?', a: "Non : la toiture reste bâchée tant que la nouvelle couverture n'est pas posée, pour rester protégée en cas de pluie." },
];
---
<Layout
  title={title}
  description={description}
  path={path}
  noindex={brouillon}
  ogImage={heroPhoto}
  jsonLd={pageSchema(path, filAriane, {
    pageName: h1,
    description,
    image: heroPhoto,
    service: { name: 'Rénovation et réfection de toiture', description },
    faq,
  })}
>
  <!-- ═══ FIL D'ARIANE ═══════════════════════════════════════════════ -->
  <Ariane label={filAriane} />

  <!-- ═══ HERO ═══════════════════════════════════════════════════════ -->
  <section class="hero-page">
    <div class="conteneur hero-page__grille">
      <div class="hero-page__texte">
        <h1>Rénovation de toiture en <em>{site.address.region}</em></h1>
        <p class="hero-page__chapo">
          Toiture ancienne, tuiles qui se déplacent, infiltrations qui reviennent : je
          remplace ou je refais la couverture, du diagnostic jusqu'à la remise en état
          complète.
        </p>
        <ul class="hero-page__points">
          <li><Icone nom="coche" taille={18} />Diagnostic sur place, sans engagement</li>
          <li><Icone nom="coche" taille={18} />Tuile, ardoise, zinc ou bac acier</li>
          <li><Icone nom="coche" taille={18} />Garantie décennale sur les travaux</li>
        </ul>
        <div class="hero-page__actions">
          <a class="btn btn--rouge btn--lg" href="/devis-gratuit/">Demander un devis<Fleche /></a>
          <a class="btn btn--lg btn--contour" href={`tel:${site.phoneHref}`}>
            <Icone nom="tel" taille={20} />{site.phone}
          </a>
        </div>
      </div>
      <div class="hero-page__media">
        <img
          class="hero-page__photo"
          src={heroPhoto}
          width="1442" height="989"
          fetchpriority="high" decoding="async"
          alt={`Vue aérienne d'une toiture en ardoise terminée, avec ses lucarnes et sa tourelle — ${site.brand}, couvreur en ${site.address.region}`}
        />
        <div class="hero-page__carte">
          <span class="hero-page__pastille"><Icone nom="coche" taille={22} /></span>
          <div>
            <strong>Garantie décennale</strong>
            <span>Tous les travaux de couverture sont couverts.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ RÉASSURANCE ════════════════════════════════════════════════ -->
  <section class="reassurance reassurance--plate">
    <div class="conteneur">
      <div class="reassurance__grille">
        {reassurance.map((r) => (
          <div class="reassurance__item">
            <strong>{r.titre}</strong>
            <span>{r.texte}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ 1. LE DIAGNOSTIC ═══════════════════════════════════════════ -->
  <section class="section">
    <div class="conteneur duo">
      <div class="duo__texte">
        <h2>Réparer, rénover ou remplacer votre toiture ?</h2>
        <p>
          Une tuile cassée ici ou là se répare. Mais quand les tuiles se déplacent
          d'elles-mêmes, que la mousse gagne tout le pan ou que les infiltrations
          reviennent après chaque réparation, c'est le signe qu'il faut aller plus loin
          qu'un rafistolage.
        </p>
        <h3>Réfection partielle ou remplacement complet</h3>
        <p>
          Une réfection partielle reprend un pan abîmé sans toucher au reste de la
          toiture. Un remplacement complet dépose toute la couverture et pose un écran
          sous-toiture neuf avant de reposer un matériau — c'est le choix quand l'usure
          touche l'ensemble du toit ou que la charpente doit être mise à nu.
        </p>
        <h3>Ce que révèle une visite sur le toit</h3>
        <p>
          Le diagnostic se fait sur place, pas sur photo : état des liteaux, de la
          charpente, ventilation des combles, humidité résiduelle. C'est ce qui permet de
          vous dire honnêtement si une réparation suffit ou s'il faut remplacer.
        </p>
      </div>
      <div class="duo__media">
        <img
          src="/photos/pavillon-vue-densemble-du-chantier-de-couverture-simonard-couvreur-77.webp"
          width="1600" height="1200" loading="lazy" decoding="async"
          alt={`Pavillon vu depuis la rue, échelle en place et panneau de chantier — ${site.brand}, couvreur en ${site.address.region}`}
        />
      </div>
    </div>
  </section>

  <!-- ═══ 2. LES ÉTAPES DU CHANTIER ══════════════════════════════════ -->
  <section class="section section--sombre">
    <div class="conteneur duo duo--inverse">
      <div class="duo__texte">
        <h2>Les étapes d'un remplacement de toiture</h2>
        <p>Un remplacement complet suit toujours le même ordre, du plus gros œuvre aux finitions :</p>
        <ul class="liste-detail">
          {etapes.map((e) => <li><strong>{e.t}</strong> — {e.d}</li>)}
        </ul>
        <a class="btn btn--rouge duo__cta" href="/devis-gratuit/">Demander un devis<Fleche /></a>
      </div>
      <div class="duo__media">
        <img
          src="/photos/banderole-simonard-sur-chantier-de-toiture-avec-echafaudage-77.webp"
          width="1200" height="900" loading="lazy" decoding="async"
          alt={`Chantier de couverture avec échafaudage et banderole ${site.brand}, toiture mise à nu`}
        />
      </div>
    </div>
  </section>

  <AppelMascotte
    titre="Une toiture à faire refaire ?"
    note="Déplacement offert"
    mascotte="face"
    inverse={true}
  />

  <!-- ═══ 3. LES MATÉRIAUX ═══════════════════════════════════════════ -->
  <section class="section">
    <div class="conteneur duo">
      <div class="duo__texte">
        <h2>Quel matériau pour votre nouvelle couverture ?</h2>
        <p>Le choix dépend de la pente du toit, du style de la maison et, souvent, du règlement d'urbanisme de la commune :</p>
        <ul class="liste-detail">
          {materiaux.map((m) => <li><strong>{m.t}</strong> — {m.d}</li>)}
        </ul>
        <!-- Maillage interne : les liens vers les pages du silo couverture
             (tuile, ardoise, zinc, bac acier, shingle) s'ajoutent ici au fur
             et à mesure qu'elles passent à 'ok' dans data/urls.js. On
             n'écrit jamais un lien vers une page qui n'existe pas. -->
        <p>J'en discute avec vous lors de la visite de diagnostic, avec un devis détaillé pour chaque option envisagée.</p>
      </div>
      <div class="duo__media">
        <img
          src="/photos/remplacement-de-toiture-en-cours-sur-pavillon-simonard-couvreur-77.webp"
          width="1600" height="1199" loading="lazy" decoding="async"
          alt={`Toiture en cours de remplacement : couverture déposée et bâche de protection posée — ${site.brand}, couvreur en ${site.address.region}`}
        />
      </div>
    </div>
  </section>

  <!-- ═══ 4. L'ISOLATION ═════════════════════════════════════════════ -->
  <section class="section section--gris">
    <div class="conteneur duo duo--inverse">
      <div class="duo__texte">
        <h2>Le toit ouvert, le bon moment pour isoler</h2>
        <p>
          Tant que la charpente est à nu, poser ou renforcer l'isolation coûte moins cher
          et va plus vite que d'ouvrir le toit une seconde fois plus tard.
        </p>
        <p>
          Si c'est votre cas, j'en parle avec vous pendant le diagnostic pour l'intégrer
          au même chantier plutôt que d'ouvrir le toit une seconde fois plus tard.
        </p>
      </div>
      <div class="duo__media">
        <img
          src="/photos/isolation-en-laine-de-verre-entre-les-liteaux-simonard-couvreur-77.webp"
          width="1600" height="1200" loading="lazy" decoding="async"
          alt={`Isolant en laine minérale posé sous une charpente neuve, avant la pose de la couverture — ${site.brand}, couvreur en ${site.address.region}`}
        />
      </div>
    </div>
  </section>

  <Faq titre="Vos questions sur la rénovation de toiture" items={faq} gris={false} />

  <!-- ═══ APPEL ══════════════════════════════════════════════════════ -->
  <section class="appel">
    <div class="conteneur">
      <h2>Votre toiture mérite un vrai diagnostic</h2>
      <p>Déplacement et chiffrage offerts, sans engagement de votre part.</p>
      <ul class="appel__points">
        <li>Devis et déplacement gratuits</li>
        <li>Interlocuteur unique</li>
        <li>Garantie décennale</li>
        <li>Urgences traitées en priorité</li>
      </ul>
      <div class="appel__actions">
        <a class="btn btn--rouge btn--lg" href="/devis-gratuit/">Demander mon devis<Fleche /></a>
        <a class="btn btn--lg btn--clair" href={`tel:${site.phoneHref}`}>
          <Icone nom="tel" taille={20} />{site.phone}
        </a>
      </div>
    </div>
  </section>
</Layout>
