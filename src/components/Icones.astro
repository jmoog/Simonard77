---
/**
 * Petites icônes SVG en ligne, partagées par tout le site.
 *
 * Pourquoi en ligne plutôt qu'un sprite ou une bibliothèque : ce sont six
 * tracés de quelques centaines d'octets. Les inliner évite une requête
 * réseau supplémentaire et permet de les colorer avec `currentColor`, donc
 * de les réutiliser sur fond clair comme sur fond sombre sans variante.
 *
 * Usage : <Icone nom="tel" taille={18} />
 */
const { nom, taille = 18, classe = '' } = Astro.props;

const TRACES = {
  tel: '<rect x="4.6" y="2" width="9.8" height="20" rx="2.9"></rect><line x1="8" y1="18.7" x2="11" y2="18.7"></line><path d="M17.9 8.9a4.6 4.6 0 0 1 0 6.2"></path><path d="M20.6 6.2a8.6 8.6 0 0 1 0 11.6"></path>',
  mail: '<rect x="2.5" y="4.5" width="19" height="15" rx="2.4"></rect><path d="m3.5 6.8 8.5 6.2 8.5-6.2"></path>',
  epingle: '<path d="M12 21.5s7-6.1 7-11.2A7 7 0 0 0 5 10.3c0 5.1 7 11.2 7 11.2Z"></path><circle cx="12" cy="10.1" r="2.6"></circle>',
  fleche: '<path d="M5 12h11.5M12 6.5l5.5 5.5-5.5 5.5"></path>',
  chevron: '<path d="M9.1 5.6c2.6 1.4 4.6 3.6 5.8 6.4-1.2 2.8-3.2 5-5.8 6.4"></path>',
  coche: '<path d="M4 12.5l5.2 5.2L20 7"></path>',
  horloge: '<circle cx="12" cy="12" r="9"></circle><path d="M12 6.8V12l3.4 2"></path>',
  cookie: '<path d="M12 3a9 9 0 1 0 9 9 3.6 3.6 0 0 1-4.3-4.3A3.6 3.6 0 0 1 12 3Z"></path><path d="M8.6 9.2v.01M14.8 15.4v.01M11.6 12.5v.01M10.2 16.6v.01M7.4 13.4v.01"></path>',
};
---
<svg
  class={classe}
  viewBox="0 0 24 24"
  width={taille}
  height={taille}
  fill="none"
  stroke="currentColor"
  stroke-width={nom === 'chevron' ? 3.4 : 2}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={TRACES[nom]}
/>
