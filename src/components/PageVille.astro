---
import Layout from '../layouts/Layout.astro';
import Icone from './Icones.astro';
import Fleche from './Fleche.astro';
import Ariane from './Ariane.astro';
import CartePrestation from './CartePrestation.astro';
import AppelMascotte from './AppelMascotte.astro';
import { site, communes } from '../data/site.js';
import { estPubliee } from '../data/urls.js';
import {
  villes, infosVille, EXPRESSIONS, METAS, ACCROCHES, PRESTATIONS_HERO,
  ARGUMENTS, SUJETS_LONG, OBJETS_LONG, TEXTES_LONGS, TEXTE_URBANISME,
  PHOTOS_HERO, PHOTOS_INTERVENTION, PORTRAITS, PHOTOS_GALERIE,
} from '../data/villes.js';
import { pageSchema } from '../data/schema.js';

/**
 * Gabarit unique des dix pages ville — les variantes sont dans data/villes.js.
 *
 * Une seule route l'utilise : `couvreur-[ville].astro`, pour les dix communes
 * préfixées « couvreur- ». Claye-Souilly n'a pas de page ville : l'accueil
 * porte « couvreur Claye-Souilly » (URL /claye-souilly/ retirée le 3 septembre
 * 2026).
 *
 * Structure (modèle LocalPlace, rédaction du 3 septembre 2026) : fil
 * d'Ariane · hero (H1, accroche, six prestations, boutons, photo) · trois
 * arguments · quatre cartes de prestations dont l'ordre tourne · section
 * photo · section longue · encadré mairie · encart mascotte · communes
 * voisines.
 *
 * La page reste en noindex tant que sa ligne dans data/urls.js n'est pas
 * passée à `status: 'ok'`.
 */
const { ville } = Astro.props;
const { nom, path, rang, slug } = ville;

// Trois expressions différentes pour le title, le H1 et le H2 de la section
// photo — jamais la même deux fois sur une page.
const exprTitle = EXPRESSIONS[rang % 4];
const exprH1 = EXPRESSIONS[(rang + 1) % 4];
const exprPhoto = EXPRESSIONS[(rang + 2) % 4];

// « de Gressy » mais « d'Annet-sur-Marne » : élision devant une voyelle.
const deNom = /^[aeiouyàâäéèêëîïôöùûüh]/i.test(nom) ? `d'${nom}` : `de ${nom}`;

const h1 = `${exprH1} à ${nom}`;

// « Devis gratuit » reste dans le title tant qu'il tient sous 60 caractères ;
// au-delà (expression longue + nom de commune long), on le retire plutôt que
// de laisser Google tronquer la marque.
const titreLong = `${exprTitle} ${nom} - Devis gratuit | ${site.brand}`;
const title = titreLong.length <= 60 ? titreLong : `${exprTitle} ${nom} | ${site.brand}`;

const description = METAS[rang % METAS.length](nom);

// Le fil d'Ariane garde la forme COURTE et constante : c'est un repère de
// navigation, identique d'une ville à l'autre, et à l'affiché correspond
// exactement le balisé (même chaîne passée à pageSchema).
const filAriane = `Couvreur à ${nom}`;

const accroche = ACCROCHES[rang % 2](nom);
// Version sans balise pour le balisage schema.org.
const accrocheTexte = accroche.replace(/<[^>]+>/g, '');
const decalage = rang % PRESTATIONS_HERO.length;
const prestationsHero = [...PRESTATIONS_HERO.slice(decalage), ...PRESTATIONS_HERO.slice(0, decalage)];
const argumentsVille = ARGUMENTS.map((pool, i) => pool[(rang + i) % pool.length]);

// La page n'entre dans l'index qu'une fois son status passé à 'ok'.
const brouillon = !estPubliee(path);

const infos = infosVille[slug] || null;
const carteMairie = infos?.mairie
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`Mairie ${deNom}, ${infos.mairie.adresse}`)}`
  : null;

// Photos : hero, intervention et portrait tournent avec le rang ; la galerie
// prend trois photos qui ne sont pas déjà affichées sur la page.
const photoHero = PHOTOS_HERO[rang % PHOTOS_HERO.length];
const photoSection = PHOTOS_INTERVENTION[rang % PHOTOS_INTERVENTION.length];
const portrait = PORTRAITS[rang % PORTRAITS.length];
const dejaVues = new Set([photoHero.src, photoSection.src, portrait.src]);
const restantes = PHOTOS_GALERIE.filter((ph) => !dejaVues.has(ph.src));
const depart = (rang * 3) % restantes.length;
const galerie = [...restantes.slice(depart), ...restantes.slice(0, depart)].slice(0, 3);
const heroPhoto = photoHero.src;

// Les quatre cartes de prestations. Leur ordre d'affichage tourne avec le
// rang. La carte ne devient un lien que le jour où sa page pilier est
// marquée `ok` dans data/urls.js (voir CartePrestation.astro).
const CARTES = [
  {
    titre: `${rang % 2 ? 'Nettoyage' : 'Démoussage'} de toiture à ${nom}`,
    texte: `Le nettoyage d'une toiture à ${nom} demande des techniques adaptées : retirer mousses, lichens et salissures sans abîmer la couverture. Les procédés employés préservent le revêtement existant, et un traitement hydrofuge vient prolonger le résultat.`,
    icone: '/icones/entretien.webp',
    href: '/nettoyage-demoussage-de-toiture/',
    items: ['Démoussage', 'Anti-mousse', 'Hydrofuge'],
  },
  {
    titre: `${rang % 2 ? 'Remplacement' : 'Rénovation'} de toiture à ${nom}`,
    texte: `${site.brand} maîtrise tous les matériaux de couverture posés à ${nom} : tuile plate, tuile mécanique, ardoise, zinc, bac acier ou shingle. Les travaux respectent les règles de pose de chaque matériau, pour une toiture remise à neuf qui tient dans le temps.`,
    icone: '/icones/couverture.webp',
    href: '/renovation-refection-de-toiture/',
    items: ['Tuile', 'Ardoise', 'Zinc', 'Bac acier'],
  },
  {
    titre: `Gouttières à ${nom}`,
    texte: `Gouttière qui déborde, fissurée ou décrochée : ${site.brand} la répare quand c'est possible et la remplace quand il le faut, en zinc, en aluminium ou en PVC, descentes comprises. Les pièces sont façonnées aux cotes relevées sur place.`,
    icone: '/icones/zinguerie.webp',
    href: '/installation-remplacement-de-gouttieres/',
    items: ['Gouttières', 'Descentes', 'Zinc, alu, PVC'],
  },
  {
    titre: `Réparation de toiture à ${nom}`,
    texte: `${site.brand} intervient rapidement pour réparer la toiture. En urgence, une bâche met le toit hors d'eau ; il cherche ensuite l'origine réelle de la fuite ou de l'infiltration, et répare là où l'eau entre, pas là où elle apparaît.`,
    icone: '/icones/reparation.webp',
    href: '/reparation-de-toiture/',
    items: ['Bâchage', 'Fuite', 'Infiltration'],
  },
];
const debut = rang % CARTES.length;
const cartes = [...CARTES.slice(debut), ...CARTES.slice(0, debut)];

// Le corps de la section longue suit l'OBJET du H2 (même index), pour que le
// texte parle bien de ce que le titre annonce.
const h2Long = `Faites appel à ${SUJETS_LONG[rang % 4]} pour ${OBJETS_LONG[(rang + 1) % 4]}`;
const paragraphesLongs = [...TEXTES_LONGS[(rang + 1) % 4](nom), TEXTE_URBANISME(deNom)];

// Communes voisines : les autres communes de la zone d'intervention. Elles ne
// deviennent des liens que le jour où leur propre page passe à `ok`.
const voisines = communes.filter((c) => c !== nom);
const lienVoisine = (nomCommune) => {
  const cible = villes.find((x) => x.nom === nomCommune);
  return cible && estPubliee(cible.path) ? cible.path : null;
};
---
<Layout
  title={title}
  description={description}
  path={path}
  noindex={brouillon}
  ogImage={heroPhoto}
  jsonLd={pageSchema(path, filAriane, {
    pageName: h1,
    description,
    image: heroPhoto,
    commune: nom,
    service: { name: h1, description: accrocheTexte },
  })}
>
  <!-- ═══ FIL D'ARIANE ═══════════════════════════════════════════════ -->
  <Ariane label={filAriane} />

  <!-- ═══ HERO ═══════════════════════════════════════════════════════
       Deux colonnes sur desktop. Sur mobile, la photo REMONTE juste sous
       le titre : les deux colonnes sont aplaties en CSS (display:contents)
       et chaque élément est replacé par `order` — voir .hero-page. -->
  <section class="hero-page">
    <div class="conteneur hero-page__grille">
      <div class="hero-page__texte">
        <h1 set:html={h1.replace(nom, `<em class="nowrap">${nom}</em>`)} />
        <p class="hero-page__chapo" set:html={accroche} />
        <ul class="hero-page__points">
          {prestationsHero.map((p) => <li><Icone nom="coche" taille={18} />{p}</li>)}
        </ul>
        <div class="hero-page__actions">
          <a class="btn btn--rouge btn--lg" href="/devis-gratuit/">Demander un devis<Fleche /></a>
          <a class="btn btn--lg btn--contour" href={`tel:${site.phoneHref}`}>
            <Icone nom="tel" taille={20} />{site.phone}
          </a>
        </div>
      </div>
      <div class="hero-page__media">
        <img
          class="hero-page__photo"
          src={heroPhoto}
          width={photoHero.w} height={photoHero.h}
          fetchpriority="high" decoding="async"
          alt={`${photoHero.alt} — ${site.brand}, couvreur à ${nom}`}
        />
        <div class="hero-page__carte">
          <span class="hero-page__pastille"><Icone nom="coche" taille={22} /></span>
          <div>
            <strong>Déplacement et devis gratuits</strong>
            <span>Un devis écrit et détaillé, sans engagement.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ TROIS ARGUMENTS ════════════════════════════════════════════ -->
  <section class="reassurance reassurance--plate">
    <div class="conteneur">
      <div class="reassurance__grille reassurance__grille--3">
        {argumentsVille.map((a) => (
          <div class="reassurance__item">
            <strong>{a.titre}</strong>
            <span>{a.texte}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ QUATRE CARTES ══════════════════════════════════════════════ -->
  <section class="section">
    <div class="conteneur">
      <div class="chapeau">
        <h2>Mes prestations de {rang % 2 ? 'couvreur zingueur' : 'couvreur'} à <span class="nowrap">{nom}</span></h2>
      </div>
      <div class="prestations prestations--4">
        {cartes.map((c) => <CartePrestation {...c} />)}
      </div>
    </div>
  </section>

  <!-- ═══ INTERVENTION, AVEC PHOTO ═══════════════════════════════════ -->
  <section class="section section--gris">
    <div class="conteneur duo">
      <div class="duo__texte">
        <h2>{exprPhoto} à <span class="nowrap">{nom}</span></h2>
        <p>
          {site.brand} se déplace rapidement chez vous pour examiner la toiture. Formé sur les
          chantiers aux côtés de la génération d'avant, il met son expérience des travaux de
          couverture au service des toits {deNom}. Le regard technique permet d'établir
          précisément l'état de la couverture, des ouvrages de zinguerie et de la charpente
          visible.
        </p>
        <p>
          Il vous dit ce qu'il faut faire, et rien de plus que ce qu'il faut pour remettre la
          toiture en état et la faire durer.
        </p>
        <a class="btn btn--rouge duo__cta" href="/devis-gratuit/">Demander un devis<Fleche /></a>
      </div>
      <div class="duo__media">
        <img
          src={photoSection.src}
          width={photoSection.w} height={photoSection.h} loading="lazy" decoding="async"
          alt={`${photoSection.alt} — ${site.brand}, couvreur à ${nom}`}
        />
      </div>
    </div>
  </section>

  <!-- ═══ L'ARTISAN ══════════════════════════════════════════════════
       Le portrait, et le nom : le visiteur doit savoir qui viendra sur son
       toit. Deux portraits et deux textes en alternance. -->
  <section class="section">
    <div class="conteneur artisan">
      <div class="artisan__media">
        <img
          src={portrait.src}
          width={portrait.w} height={portrait.h} loading="lazy" decoding="async"
          alt={`${portrait.alt} — ${site.brand}, couvreur à ${nom}`}
        />
      </div>
      <div class="artisan__texte">
        {rang % 2 === 0 ? (
          <>
            <h2>{site.founder}, couvreur de père en fils</h2>
            <p>
              Le métier, je l'ai appris sur les chantiers, aux côtés de la génération d'avant.
              C'est ce savoir-faire artisanal que mon équipe et moi apportons sur les toitures
              {deNom} : le geste juste, le bon matériau, et une finition qu'on n'a pas besoin
              de reprendre.
            </p>
            <p>
              Je viens voir votre toit, je vous dis ce qu'il faut faire — et ce qu'il ne faut
              pas faire — puis je réalise les travaux avec mon équipe. La qualité de l'ouvrage
              et votre satisfaction sont ce qui compte, du premier appel à la fin du chantier.
            </p>
          </>
        ) : (
          <>
            <h2>{site.founder}, un savoir-faire d'artisan couvreur</h2>
            <p>
              Artisan couvreur zingueur formé sur les chantiers, j'ai repris le métier de la
              génération d'avant avec ses exigences : un diagnostic honnête, des matériaux
              choisis pour durer, une pose dans les règles de l'art. C'est ce professionnalisme
              que mon équipe et moi apportons sur les toitures {deNom}.
            </p>
            <p>
              Compétence, expérience et amour du travail bien fait : c'est ce que vous êtes en
              droit d'attendre d'une entreprise de couverture, et c'est ce que nous mettons
              dans le moindre chantier. Tous les travaux sont couverts par la garantie
              décennale.
            </p>
          </>
        )}
        <a class="btn btn--bleu" href="/devis-gratuit/">Me contacter<Fleche /></a>
      </div>
    </div>
  </section>

  <!-- ═══ GALERIE ════════════════════════════════════════════════════ -->
  <section class="section section--gris">
    <div class="conteneur">
      <div class="chapeau">
        <h2>Des travaux de couverture réalisés à <span class="nowrap">{nom}</span></h2>
        <p>Trois chantiers de couverture, de zinguerie et d'isolation menés par l'équipe, à {nom} et dans les communes voisines.</p>
      </div>
      <div class="galerie">
        {galerie.map((ph) => (
          <figure>
            <img src={ph.src} width={ph.w} height={ph.h} loading="lazy" decoding="async" alt={`${ph.alt} — ${site.brand}`} />
            <figcaption>{ph.alt}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ SECTION LONGUE + MAIRIE ════════════════════════════════════ -->
  <section class="section">
    <div class="conteneur">
      <div class="colonne">
      <div class="chapeau chapeau--gauche">
        <h2>{h2Long}</h2>
      </div>
      <!-- Quatre variantes (data/villes.js, TEXTES_LONGS), choisies par
           l'objet du H2, puis le paragraphe d'urbanisme qui amène l'encadré
           mairie. Les liens y sont conditionnés à la publication de la page
           cible (lienSiPubliee). -->
      <div class="page-texte">
        {paragraphesLongs.map((texte) => <p set:html={texte} />)}
      </div>

      <!-- Mairie : coordonnées relevées sur l'annuaire officiel (data/villes.js).
           Sans coordonnées vérifiées, un encart d'attente — jamais une adresse
           inventée. -->
      {infos?.mairie ? (
        <div class="mairie">
          <div class="mairie__icone"><Icone nom="epingle" taille={24} /></div>
          <div class="mairie__texte">
            <strong>Mairie {deNom}</strong>
            <p>
              Renseignez-vous auprès des services de la mairie {deNom} pour vos démarches et
              déclarations préalables.<br />
              Adresse de la mairie : {infos.mairie.adresse}
              {infos.mairie.tel && <><br />Téléphone : <span class="nowrap">{infos.mairie.tel}</span></>}
            </p>
          </div>
          <div class="mairie__actions">
            {carteMairie && <a class="btn btn--contour" href={carteMairie} target="_blank" rel="noopener">Voir sur la carte</a>}
            {infos.mairie.site && <a class="btn btn--contour" href={infos.mairie.site} target="_blank" rel="noopener">Site internet</a>}
          </div>
        </div>
      ) : (
        <div class="mairie mairie--attente">
          <div class="mairie__icone"><Icone nom="epingle" taille={24} /></div>
          <div class="mairie__texte">
            <strong>Mairie {deNom}</strong>
            <p>Coordonnées à renseigner dans <code>data/villes.js</code> — aucune adresse n'est affichée tant qu'elle n'a pas été vérifiée.</p>
          </div>
        </div>
      )}
      </div>
    </div>
  </section>

  <!-- ═══ APPEL MASCOTTE ═════════════════════════════════════════════
       Les deux dessins alternent d'une ville à l'autre ; chacun est monté
       du côté vers lequel son pouce pointe (voir AppelMascotte.astro). -->
  <AppelMascotte
    titre={`Une toiture à voir à ${nom} ?`}
    texte="Appelez-moi : je me déplace, j'examine la toiture et vous recevez un devis écrit, détaillé et gratuit."
    note="Devis gratuit, déplacement offert"
    mascotte={rang % 2 ? 'face' : 'gauche'}
    inverse={rang % 2 === 1}
  />

  <!-- ═══ COMMUNES VOISINES ══════════════════════════════════════════ -->
  <section class="section section--ciel">
    <div class="conteneur">
      <div class="chapeau">
        <h2>Autour <span class="nowrap">{deNom}</span></h2>
        <p>Les communes voisines où {site.brand} intervient également.</p>
      </div>
      <ul class="communes">
        {voisines.map((c) => {
          const href = lienVoisine(c);
          return <li>{href ? <a href={href}>{c}</a> : c}</li>;
        })}
      </ul>
    </div>
  </section>
</Layout>
