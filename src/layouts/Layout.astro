---
import '../styles/global.css';
import { site, mainNav, communes } from '../data/site.js';
import { urls, parSilo } from '../data/urls.js';
import Icone from '../components/Icones.astro';
import Fleche from '../components/Fleche.astro';
import IconeWhatsApp from '../components/IconeWhatsApp.astro';

const {
  title,
  description,
  path = '/',
  ogImage = '/og-simonard-couvreur-77.jpg',
  jsonLd = null,
  // Pages de service (/merci/, 404) : à exclure de l'index Google.
  noindex = false,
} = Astro.props;

const canonical = new URL(path, site.domain).toString();

// Le footer liste les prestations par silo. Comme aucune page de prestation
// n'est encore migrée, on affiche les rubriques telles quelles : celles qui
// ont une page en ligne deviennent des liens, les autres restent en texte.
const rubriques = [
  { cle: 'couverture', label: 'Couverture' },
  // Le silo « entretien » est présenté sous le nom de la prestation que les
  // gens recherchent (nettoyage, démoussage), pas sous le mot « entretien » :
  // le lien vise donc explicitement la page nettoyage, pas la page pilier.
  { cle: 'entretien', label: 'Nettoyage toiture', path: '/nettoyage-demoussage-de-toiture/' },
  { cle: 'zinguerie', label: 'Zinguerie' },
  { cle: 'isolation', label: 'Isolation' },
  { cle: 'etancheite', label: 'Étanchéité' },
];
// Pour chaque rubrique : la page imposée (`path`) si elle est publiée, sinon
// le lien de sa page pilier si elle est publiée.
const lienRubrique = ({ cle, path }) => {
  if (path) return parSilo(cle).some((u) => u.path === path) ? path : null;
  const pilier = parSilo(cle).find((u) => u.pilier) || parSilo(cle)[0];
  return pilier ? pilier.path : null;
};
const villesPubliees = parSilo('ville');
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- Polices auto-hébergées (public/fonts/) : conformité RGPD — aucune
       requête vers Google Fonts, donc aucune adresse IP visiteur transmise
       avant tout consentement. -->
  <link rel="preload" href="/fonts/poppins-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
  {/* Vérification de la propriété Search Console (méthode « Balise HTML »).
      Ne dépose rien et ne dépend d'aucun consentement — voir data/site.js. */}
  {site.googleSiteVerification && <meta name="google-site-verification" content={site.googleSiteVerification} />}
  <!-- Favicons. Googlebot-Image ne récupère de façon fiable qu'un fichier
       matriciel : l'ICO est déclaré en premier et reste servi sur
       /favicon.ico, l'URL que les crawlers demandent par défaut. -->
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon-48x48.png" type="image/png" sizes="48x48" />
  <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#025E95" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:site_name" content={`${site.brand} — Couvreur ${site.address.department}`} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(ogImage, site.domain).toString()} />
  <meta name="twitter:card" content="summary_large_image" />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <script is:inline>
    // Posé avant le premier rendu : sans cette classe, aucun bloc n'est masqué
    // et la page s'affiche telle quelle. On n'anime que si le navigateur sait
    // observer le défilement et si l'utilisateur n'a pas demandé à réduire
    // les animations.
    if ('IntersectionObserver' in window &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('js-anim');
    }
  </script>
</head>
<body>
  <a class="saut-contenu" href="#contenu">Aller au contenu</a>

  {/* Bandeau cookies. Placé en tête du document pour qu'un visiteur au
      clavier l'atteigne en deux tabulations ; visuellement il est fixé en
      bas. Non bloquant : pas de voile, le site reste utilisable derrière.
      Masqué (hidden) tant que le script ne l'ouvre pas : sans JavaScript il
      n'apparaît jamais — et rien n'est chargé non plus. */}
  <div id="bandeau-cookies" class="bandeau-cookies" hidden>
    <div class="bandeau-cookies__carte" role="dialog" aria-labelledby="cookies-titre" aria-describedby="cookies-texte">
      <div class="bandeau-cookies__entete">
        <span class="bandeau-cookies__icone"><Icone nom="cookie" taille={22} /></span>
        <p class="bandeau-cookies__titre" id="cookies-titre">Cookies : à vous de choisir</p>
      </div>
      <p class="bandeau-cookies__texte" id="cookies-texte">
        Ce site utilise Google Analytics pour savoir combien de personnes le visitent et quelles
        pages les intéressent. Rien n'est déposé tant que vous n'avez pas choisi, et le site
        fonctionne exactement pareil si vous refusez.
        <a href="/mentions-legales/#cookies">En savoir plus</a>
      </p>
      <p class="bandeau-cookies__etat" id="cookies-etat" hidden></p>
      <div class="bandeau-cookies__actions">
        <button type="button" class="btn btn--bleu" id="cookies-refus">Refuser</button>
        <button type="button" class="btn btn--bleu" id="cookies-accord">Accepter</button>
      </div>
      <p class="bandeau-cookies__note">Vous pourrez changer d'avis à tout moment via « Gérer les cookies », en bas de page.</p>
    </div>
  </div>

  <div class="barre-haute">
    <div class="conteneur">
      <span class="barre-haute__gauche">Devis et déplacement gratuits<span class="barre-haute__zone">{` — ${site.address.region} et limitrophes`}</span></span>
      <span class="barre-haute__droite">
        <a href={`mailto:${site.email}`}><Icone nom="mail" taille={15} />{site.email}</a>
        <a href={`tel:${site.phoneHref}`}><Icone nom="tel" taille={15} />{site.phone}</a>
      </span>
    </div>
  </div>

  <header class="entete">
    <div class="conteneur">
      <a class="entete__logo" href="/" aria-label={`Accueil — ${site.brand}, artisan couvreur`}>
        <img src="/logo-simonard-couvreur-77.webp" alt={`${site.brand}, artisan couvreur en ${site.address.region}`} width="922" height="200" />
      </a>

      <input type="checkbox" id="nav-bascule" class="nav-bascule" hidden />
      <label for="nav-bascule" class="nav-burger" aria-label="Ouvrir le menu"><span></span></label>
      <label for="nav-bascule" class="nav-voile" aria-hidden="true"></label>

      <div class="nav-panneau">
        <label for="nav-bascule" class="nav-fermer" aria-label="Fermer le menu"></label>
        <img class="nav-panneau__logo" src="/logo-simonard-couvreur-77.webp" width="922" height="200" alt={`${site.brand}, artisan couvreur en ${site.address.region}`} />

        <nav class="nav" aria-label="Navigation principale">
          {/* Rubrique sans `href` : sa page n'est pas encore migrée, on la
              rend en <span> plutôt qu'en lien mort — voir data/site.js. */}
          {mainNav.map((item) => (item.href ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>))}
        </nav>

        <div class="entete__actions">
          <a class="entete__tel" href={`tel:${site.phoneHref}`}>
            <span class="entete__tel-rond"><Icone nom="tel" taille={19} /></span>
            <span class="entete__tel-txt"><small>Appelez-moi</small><strong>{site.phone}</strong></span>
          </a>
          <a
            class="btn btn--wa"
            href={site.whatsapp}
            target="_blank"
            rel="noopener"
            aria-label={`Écrire à ${site.brand} sur WhatsApp`}
          >
            <IconeWhatsApp taille={18} /><span class="entete__wa-txt">WhatsApp</span>
          </a>
          <a class="btn btn--rouge" href="/devis-gratuit/">Devis gratuit<Fleche /></a>
        </div>
      </div>
    </div>
  </header>

  <div class="barre-mobile">
    <a class="btn btn--rouge" href="/devis-gratuit/">Devis gratuit<Fleche /></a>
    <a class="btn btn--bleu" href={`tel:${site.phoneHref}`}><Icone nom="tel" taille={16} />{site.phone}</a>
    <a
      class="btn btn--wa btn--carre"
      href={site.whatsapp}
      target="_blank"
      rel="noopener"
      aria-label={`Écrire à ${site.brand} sur WhatsApp`}
    >
      <IconeWhatsApp taille={21} />
    </a>
  </div>

  <script type="module">
    // Fait apparaître la barre d'action mobile une fois l'en-tête sorti de
    // l'écran (et non dès le premier pixel : elle masquerait le hero).
    const maj = () => document.body.classList.toggle('defile', window.scrollY > 900);
    window.addEventListener('scroll', maj, { passive: true });
    maj();
  </script>

  <main id="contenu">
    <slot />
  </main>

  <footer class="pied">
    <div class="conteneur">
      <div class="pied__cols">
        <div class="pied__marque">
          <span class="pied__logo"><img src="/logo-simonard-couvreur-77.webp" width="922" height="200" alt={`${site.brand}, artisan couvreur en ${site.address.region}`} loading="lazy" /></span>
          <p class="pied__nom">{site.brand}</p>
          <p>Artisan couvreur zingueur en {site.address.region} ({site.address.department})</p>
          <p>
            {site.address.street}<br />{site.address.postalCode} {site.address.city}<br />
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </p>
          <div class="pied__actions">
            <a class="btn btn--rouge" href={`tel:${site.phoneHref}`}>
              <Icone nom="tel" taille={17} />{site.phone}
            </a>
            <a
              class="btn btn--wa"
              href={site.whatsapp}
              target="_blank"
              rel="noopener"
              aria-label={`Écrire à ${site.brand} sur WhatsApp`}
            >
              <IconeWhatsApp taille={17} />WhatsApp
            </a>
            <a class="btn pied__btn-devis" href="/devis-gratuit/">Devis gratuit<Fleche /></a>
          </div>
          {/* Le bloc « avis Google » n'apparaît que le jour où la fiche
              existe : un lien vide vaudrait moins que pas de lien du tout. */}
          {site.googleReviewUrl && (
            <a class="pied__avis" href={site.googleReviewUrl} target="_blank" rel="noopener noreferrer">
              <span class="etoiles" aria-hidden="true">★★★★★</span>
              <span>Laissez-nous un avis Google</span>
            </a>
          )}
        </div>

        <div class="pied__pile">
          <div>
            <h4>Prestations</h4>
            <ul>
              {rubriques.map((r) => {
                const href = lienRubrique(r);
                return <li>{href ? <a href={href}>{r.label}</a> : <span class="attente">{r.label}</span>}</li>;
              })}
            </ul>
          </div>
          <div>
            <h4>Informations</h4>
            <ul>
              <li><a href="/devis-gratuit/">Devis gratuit</a></li>
              <li><a href="/plan-du-site/">Plan du site</a></li>
              <li><a href="/mentions-legales/">Mentions légales</a></li>
              <li><a href="/mentions-legales/#cookies" data-cookies>Gérer les cookies</a></li>
            </ul>
          </div>
        </div>

        <div>
          <h4>Zone d'intervention</h4>
          <ul class="pied__villes">
            {/* Tant qu'aucune page ville n'est migrée, on affiche les
                communes en texte : elles informent le visiteur et donnent le
                contexte géographique sans créer de lien mort. */}
            {villesPubliees.length > 0
              ? villesPubliees.map((v) => <li><a href={v.path}>{v.label}</a></li>)
              : communes.map((c) => <li><span class="attente">{c}</span></li>)}
          </ul>
        </div>

      </div>

      <div class="pied__bas">
        <p>
          {site.brand} — Artisan couvreur zingueur en {site.address.region} ({site.address.department}).
          Devis gratuit et déplacement offert.
        </p>
        <p class="pied__legal">{site.legalName} · SIRET {site.siret}</p>
        <a class="pied__signature" href="https://local-place.fr/" target="_blank" rel="noopener noreferrer">
          <span class="pied__signature-badge"><img src="/logo-the-local-place.png" width="65" height="22" alt="The Local Place" loading="lazy" /></span>
          <span>Site créé et référencé par The Local Place</span>
        </a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var racine = document.documentElement;
      if (!racine.classList.contains('js-anim')) return;

      // Filet de sécurité : si quoi que ce soit échoue ci-dessous, on retire
      // la classe et tout redevient visible. Mieux vaut une page sans
      // animation qu'une page vide.
      try {
        var CIBLES = [
          '.chapeau', '.reassurance__item', '.prestation',
          '.artisan__media', '.artisan__texte',
          '.duo__texte', '.duo__media',
          '.etape', '.suite__item', '.liens a',
          '.appel__grille > *',
          '.devis__intro', '.formulaire-carte', '.carte-zone', '.communes',
          '.mairie', '.titre-liste',
        ].join(',');

        var blocs = document.querySelectorAll(CIBLES);
        for (var i = 0; i < blocs.length; i++) blocs[i].classList.add('apparait');

        // Apparition en cascade au sein d'un même groupe : les cartes d'une
        // grille arrivent l'une après l'autre plutôt qu'en bloc. Plafonné à
        // 320 ms — au-delà, la dernière carte se fait attendre.
        var groupes = document.querySelectorAll(
          '.prestations, .reassurance__grille, .etapes, .suite, .liens'
        );
        for (var g = 0; g < groupes.length; g++) {
          var enfants = groupes[g].children;
          for (var e = 0; e < enfants.length; e++) {
            if (enfants[e].classList.contains('apparait')) {
              enfants[e].style.transitionDelay = Math.min(e * 80, 320) + 'ms';
            }
          }
        }

        var observateur = new IntersectionObserver(function (entrees) {
          for (var k = 0; k < entrees.length; k++) {
            if (!entrees[k].isIntersecting) continue;
            entrees[k].target.classList.add('est-visible');
            // Une seule fois : rejouer l'animation à chaque passage fatigue,
            // et c'est le genre de détail qui fait fermer un onglet.
            observateur.unobserve(entrees[k].target);
          }
        }, {
          // Le bloc doit être entré d'un dixième d'écran avant d'apparaître :
          // déclenché pile au bord, le mouvement passe inaperçu.
          rootMargin: '0px 0px -10% 0px',
          threshold: 0.05,
        });

        for (var j = 0; j < blocs.length; j++) observateur.observe(blocs[j]);
      } catch (err) {
        racine.classList.remove('js-anim');
      }
    })();
  </script>

  <script is:inline define:vars={{ GA_ID: site.gaId }}>
    (function () {
      // Mesure d'audience — mode strict CNIL (« basic » du Consent Mode) :
      // le script Google n'est chargé QU'APRÈS un clic sur « Accepter ».
      // Avant ce clic, et en cas de refus, aucune requête ne part vers Google
      // et aucun cookie n'est déposé. GA_ID vient de data/site.js ; vide, le
      // bandeau ne s'affiche pas (il n'aurait rien à demander).
      var CLE = 'simonard-cookies';
      // À incrémenter si la finalité ou l'outil change : le bandeau se
      // représente alors à tous les visiteurs, y compris ceux qui avaient déjà
      // répondu — un consentement donné pour autre chose ne vaut plus.
      var VERSION = 1;
      // Le choix (accord ou refus) est mémorisé 6 mois, durée recommandée par
      // la CNIL, puis la question est reposée.
      var DUREE_CHOIX = 182 * 24 * 3600 * 1000;
      // Les cookies déposés par Analytics sont plafonnés à 13 mois (durée de
      // vie maximale d'un traceur selon la CNIL ; par défaut GA4 met 2 ans).
      var DUREE_COOKIES_GA = 33696000;

      var bandeau = document.getElementById('bandeau-cookies');
      if (!bandeau || !GA_ID) return;
      var etat = document.getElementById('cookies-etat');
      var btnAccord = document.getElementById('cookies-accord');
      var btnRefus = document.getElementById('cookies-refus');
      var declencheur = null;

      function lireChoix() {
        try {
          var brut = JSON.parse(localStorage.getItem(CLE));
          if (!brut || brut.v !== VERSION) return null;
          if (Date.now() - brut.t > DUREE_CHOIX) return null;
          return brut.c === 'oui' ? 'oui' : 'non';
        } catch (e) { return null; }
      }
      function ecrireChoix(c) {
        try { localStorage.setItem(CLE, JSON.stringify({ v: VERSION, c: c, t: Date.now() })); } catch (e) {}
      }

      function chargerGA() {
        if (window.__gaCharge) return;
        window.__gaCharge = true;
        window['ga-disable-' + GA_ID] = false;
        window.dataLayer = window.dataLayer || [];
        function gtag() { window.dataLayer.push(arguments); }
        window.gtag = gtag;
        // Signaux Consent Mode v2 : seule la mesure d'audience est accordée,
        // le site n'utilise ni Google Ads ni personnalisation publicitaire.
        gtag('consent', 'default', {
          ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',
          analytics_storage: 'granted'
        });
        gtag('js', new Date());
        gtag('config', GA_ID, { cookie_expires: DUREE_COOKIES_GA });
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
        document.head.appendChild(s);
      }
      // Retrait du consentement : Analytics est coupé pour la page en cours
      // et ses cookies effacés (sur l'hôte et sur le domaine parent, GA les
      // pose sur ce dernier).
      function couperGA() {
        window['ga-disable-' + GA_ID] = true;
        var hote = location.hostname, parts = hote.split('.');
        var domaines = ['', hote];
        if (parts.length > 2) domaines.push(parts.slice(-2).join('.'));
        document.cookie.split(';').forEach(function (c) {
          var nom = c.split('=')[0].trim();
          if (nom !== '_ga' && nom !== '_gid' && nom.indexOf('_ga_') !== 0) return;
          domaines.forEach(function (d) {
            document.cookie = nom + '=; Max-Age=0; path=/' + (d ? '; domain=' + d : '');
          });
        });
      }

      function afficher(depuis) {
        declencheur = depuis || null;
        var choix = lireChoix();
        if (choix) {
          etat.textContent = 'Votre choix actuel : mesure d’audience ' + (choix === 'oui' ? 'acceptée' : 'refusée') + '.';
          etat.hidden = false;
        } else {
          etat.hidden = true;
        }
        bandeau.hidden = false;
        requestAnimationFrame(function () {
          bandeau.classList.add('est-visible');
          // Ouverture demandée par le visiteur : le focus suit, pour le
          // clavier et les lecteurs d'écran. À l'ouverture automatique on ne
          // vole pas le focus — le bandeau n'est pas modal.
          if (depuis) btnRefus.focus();
        });
      }
      function masquer() {
        bandeau.classList.remove('est-visible');
        setTimeout(function () { bandeau.hidden = true; }, 450);
        if (declencheur) { declencheur.focus(); declencheur = null; }
      }

      var choix = lireChoix();
      if (choix === 'oui') chargerGA();
      // Pas encore répondu (ou choix périmé) : le bandeau arrive après un
      // court délai, une fois la page posée, plutôt qu'en même temps qu'elle.
      else if (choix === null) setTimeout(function () { afficher(); }, 700);

      btnAccord.addEventListener('click', function () {
        ecrireChoix('oui'); chargerGA(); masquer();
      });
      btnRefus.addEventListener('click', function () {
        ecrireChoix('non'); masquer();
        if (window.__gaCharge) couperGA();
      });
      // Liens « Gérer les cookies » (pied de page, mentions légales) : sans
      // JavaScript ils mènent au paragraphe cookies des mentions légales.
      document.addEventListener('click', function (e) {
        var lien = e.target.closest('[data-cookies]');
        if (!lien) return;
        e.preventDefault();
        afficher(lien);
      });
    })();
  </script>
</body>
</html>
