# Copiez ce fichier en `.env` pour tester en local (le vrai `.env` n'est
# jamais versionné). En production, ces variables se règlent dans l'outil de
# déploiement (Coolify, etc.) — voir le README.

# --- Envoi des e-mails de devis (API Brevo) ---
# Pourquoi Brevo et pas un simple SMTP : la plupart des hébergeurs bloquent
# les ports SMTP sortants (25, 465, 587). L'API HTTPS de Brevo passe par le
# port 443, qui n'est jamais bloqué.
BREVO_API_KEY=
# Destinataires des demandes de devis, séparés par une virgule
ADMIN_EMAILS=contact@simonard.fr,jmoog27@gmail.com
# Expéditeur technique — aligné sur simonard93 : devis@simonard.fr y est
# déjà l'expéditeur vérifié dans Brevo. Même compte Brevo pour ce site →
# devis@simonard.fr fonctionne ici aussi sans revalidation. Nouveau compte
# Brevo → revalider cette adresse comme expéditeur unique (ou authentifier
# le domaine simonard.fr), sinon Brevo refusera l'envoi.
FROM_EMAIL=devis@simonard.fr
FROM_NAME=M. Simonard

# --- Anti-spam Cloudflare Turnstile (facultatif) ---
# PUBLIC_TURNSTILE_SITE_KEY est une variable de BUILD (elle est écrite dans
# le HTML) : si vous la changez, il faut relancer un build complet.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Règles anti-spam centralisées (facultatif) ---
# JSON de règles (mots-clés, seuil, indicatifs suspects, mots anglais) partagé
# entre plusieurs sites — voir src/lib/antispam.ts. Si absent ou injoignable,
# le site retombe sur des règles intégrées au code (protection inchangée).
SPAM_RULES_URL=https://raw.githubusercontent.com/jmoog/antispam-rules/main/rules.json
# Durée du cache des règles en secondes (par défaut 3600 = 1h si absent)
SPAM_RULES_TTL=3600
